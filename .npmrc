# better-auth dichiara un peer OPZIONALE su @tanstack/react-start, che pretende
# vite >= 7, mentre Astro 5 qui gira su vite 6. TanStack non lo usiamo: il
# conflitto e' nominale e npm si rifiuterebbe comunque di installare.
# Senza questo file la build su Vercel fallisce come falliva in locale.
legacy-peer-deps=true
