---
// Atterraggio del QR stampato su biglietti da visita e volantino, versione
// fotovoltaico per SSEC 2026 (Fiera di Vicenza, 22-23 settembre). Chi apre e' un
// fornitore del fotovoltaico: qui vede il canone del noleggio contro la bolletta
// del suo cliente, e puo' verificare il cliente con la partita IVA.
// Guscio, vCard e modulo stanno in FieraLayout, condiviso con /fiera2.
import FieraLayout from '../layouts/FieraLayout.astro';
import BusinessPlanFiera from '../components/fiera/BusinessPlanFiera.tsx';
---
<FieraLayout
  fonte="fiera-ssec-2026"
  waTesto="Ciao Alberto, ci siamo visti a SSEC"
  titoloModulo="Ti mando il business plan del tuo cliente"
  sottotitoloModulo="Rispondo entro 24 ore con il prospetto completo."
  etichettaNote="Note sull'impianto o sul cliente"
  suggerimentoNote="Tetto, accumulo, tempi di installazione, chi è il cliente..."
  descrizione="Noleggio operativo per il fotovoltaico: il canone contro la bolletta del cliente. Salva il contatto di Alberto Amà."
  arcoDurate="24-84"
>
  <BusinessPlanFiera client:load />
</FieraLayout>
