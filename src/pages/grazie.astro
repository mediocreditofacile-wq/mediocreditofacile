---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Grazie per la tua richiesta | Mediocredito Facile"
  description="Abbiamo ricevuto la tua richiesta. Ti ricontatteremo entro 24 ore lavorative."
  noindex={true}
>
  <Header minimal={true} />
  <script>
    window.dataLayer = window.dataLayer || [];
    // Estrai lo slug della landing dal referrer per tracciare la provenienza del lead
    const referrer = document.referrer || '';
    let fonte = 'diretto';
    try {
      const url = new URL(referrer);
      const path = url.pathname.replace(/^\/|\/$/g, '');
      if (path) fonte = path;
      else fonte = 'homepage';
    } catch (_) {}
    window.dataLayer.push({ event: 'generate_lead' });
    window.dataLayer.push({ event: 'form_submission', fonte: fonte });
  </script>
  <main class="grazie">
    <div class="grazie__inner">
      <div class="grazie__icon">✓</div>
      <h1 class="grazie__title">Richiesta ricevuta!</h1>
      <p class="grazie__sub">Ti ricontatteremo entro 24 ore lavorative per fornirti il preventivo personalizzato.</p>
      <a href="/" class="grazie__cta">Torna alla home</a>
    </div>
    <!-- Esito della verifica del simulatore di noleggio: lo riempie lo script qui sotto -->
    <div class="grazie-esito" id="grazie-esito" hidden></div>
  </main>
  <Footer />
</Layout>

<script>
  // Verifica del cliente sul simulatore di noleggio operativo: il modulo salva
  // l'esito in sessionStorage e rimanda qui, perche' la conversione Google Ads
  // scatta sulla visita a /grazie. Senza esito (tutti gli altri moduli) la
  // pagina resta quella di sempre. L'esito si cancella appena letto.
  import { mostraEsitoSimulatore } from '../scripts/esito-grazie';
  mostraEsitoSimulatore();
</script>

<style is:global>
  /* Markup creato dallo script: lo scoping di Astro non lo raggiunge */
  .grazie--esito { align-items: flex-start; }
  .grazie--esito .grazie__inner { display: none; }
  .grazie-esito { max-width: 640px; width: 100%; text-align: left; }
  .grazie-esito h1 { font-size: 1.75rem; font-weight: 800; color: #0F1020; margin: 0 0 0.5rem; }
  .grazie-esito__azienda { color: #444451; margin: 0 0 1.25rem; line-height: 1.5; }
  .grazie-esito__azienda strong { color: #0F1020; }
  .grazie-esito__colore { display: flex; gap: 0.75rem; align-items: flex-start; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; line-height: 1.55; }
  .grazie-esito__punto { flex: none; width: 14px; height: 14px; border-radius: 50%; margin-top: 0.3rem; background: currentColor; }
  .grazie-esito__colore p { margin: 0; color: #444451; }
  .grazie-esito__colore--verde { background: rgba(45,143,78,0.10); color: #2D8F4E; }
  .grazie-esito__colore--giallo { background: rgba(230,168,23,0.14); color: #9A6B00; }
  .grazie-esito__colore--rosso { background: rgba(204,51,51,0.08); color: #CC3333; }
  .grazie-esito__colore--neutro { background: #F8F7FA; color: #664CCD; }
  .grazie-esito h2 { font-size: 1rem; color: #664CCD; margin: 1.5rem 0 0.5rem; }
  .grazie-esito ul { margin: 0; padding: 0; list-style: none; }
  .grazie-esito__criteri li { padding: 0.35rem 0 0.35rem 1.6rem; position: relative; color: #444451; border-bottom: 1px solid #E1DEE3; }
  .grazie-esito__criteri li::before { position: absolute; left: 0; font-weight: 800; }
  .grazie-esito__criteri li.ok::before { content: '✓'; color: #2D8F4E; }
  .grazie-esito__criteri li.ko::before { content: '✗'; color: #CC3333; }
  .grazie-esito__criteri li.nd::before { content: '–'; color: #787782; }
  .grazie-esito__indicazioni li, .grazie-esito__documenti li { padding: 0.3rem 0 0.3rem 1.1rem; position: relative; color: #444451; line-height: 1.55; }
  .grazie-esito__indicazioni li::before, .grazie-esito__documenti li::before { content: ''; position: absolute; left: 0; top: 0.85rem; width: 6px; height: 6px; border-radius: 50%; background: #FE6F3A; }
  .grazie-esito__scarica { margin: 0 0 1.25rem; }
  .grazie-esito__scarica button { background: #FE6F3A; color: #fff; border: 0; border-radius: 8px; padding: 0.9rem 1.25rem; font-family: inherit; font-size: 1rem; font-weight: 700; cursor: pointer; }
  .grazie-esito__scarica button:hover { background: #D45A2E; }
  .grazie-esito__nota { font-size: 0.85rem; color: #787782; margin: 1.5rem 0 0; }
  .grazie-esito__azioni { margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap; }
  .grazie-esito__azioni a { color: #664CCD; font-weight: 600; }
</style>

<style>
  .grazie {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
  }

  .grazie__inner {
    text-align: center;
    max-width: 480px;
  }

  .grazie__icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .grazie__title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-heading);
    margin-bottom: 1rem;
  }

  .grazie__sub {
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .grazie__cta {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    padding: 0.875rem 2rem;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 1rem;
    transition: background 0.2s;
  }

  .grazie__cta:hover {
    background: var(--color-primary-light);
  }
</style>
