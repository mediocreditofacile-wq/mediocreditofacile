---
import Icon from '../../components/Icon.astro';
/**
 * Portale fornitore InnovaLux S.r.l. — /tools/innovalux
 *
 * Diverso dagli altri portali partner: qui non si caricano pratiche, si generano
 * preventivi. Il fornitore inserisce i dati dell'impianto e ottiene i due
 * prospetti PDF (analitico e infografico) che finora produceva Alberto a mano.
 *
 * - login con email + password (referente Antonia)
 * - form cliente / impianto / consumi (opzionali) / durata
 * - riepilogo numeri a schermo + download dei due PDF
 * - storico dei preventivi generati
 *
 * Tutto il calcolo gira server-side (/api/preventivo-innovalux): i coefficienti
 * non entrano nel bundle. Se il microservizio PDF non risponde, i numeri restano
 * a schermo e il portale lo dice, senza far fallire il preventivo.
 *
 * Ratio interna (NON esposta in pagina): InnovaLux (Milano, P.IVA 13991550966)
 * fornisce e installa impianti fotovoltaici chiavi in mano. Il ciclo prima era
 * mail di Antonia -> calcolo di Alberto -> due PDF: il portale lo ribalta sul
 * fornitore, lasciando ad Alberto la notifica e lo storico.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout
  title="Portale InnovaLux — Preventivi fotovoltaico | Mediocredito Facile"
  description="Portale riservato InnovaLux S.r.l.: generazione dei prospetti di noleggio operativo e leasing per impianti fotovoltaici con accumulo."
  noindex={true}
  breadcrumbs={[{ name: 'Portale InnovaLux', href: '/tools/innovalux' }]}
>
  <!-- Gate login -->
  <div id="gate" class="gate">
    <div class="gate__card">
      <div class="gate__logos">
        <img src="/images/logo-mediocreditofacile.webp" alt="Mediocredito Facile" class="gate__logo" />
        <span class="gate__x">&times;</span>
        <span class="gate__partner-name">InnovaLux S.r.l.</span>
      </div>
      <div class="gate__divider"></div>
      <p class="gate__label">Portale Riservato Fornitore</p>
      <p class="gate__desc">Genera i prospetti di noleggio operativo e il confronto con il leasing per i tuoi impianti fotovoltaici.</p>
      <div class="gate__form">
        <input type="email" id="gate-user" class="gate__input" placeholder="Email" autocomplete="username" />
        <input type="password" id="gate-pwd" class="gate__input" placeholder="Password" autocomplete="current-password" />
        <button id="gate-btn" class="gate__btn">
          <Icon name="lock_open" />
          Accedi
        </button>
      </div>
      <p id="gate-error" class="gate__error" hidden>Email o password non corretti</p>
    </div>
  </div>

  <!-- Portale (nascosto fino ad autenticazione) -->
  <div id="tool" class="il" style="display:none !important;">
    <div class="il__header">
      <div class="il__header-brand">
        <img src="/images/logo-mediocreditofacile.webp" alt="Mediocredito Facile" class="il__logo" />
        <div class="il__header-sep"></div>
        <div class="il__partner-badge">
          <span class="il__partner-icon"><Icon name="solar_power" size={18} /></span>
          <span class="il__partner-label">InnovaLux S.r.l.</span>
        </div>
      </div>
      <button id="logout-btn" class="il__logout">
        <Icon name="logout" />
        Esci
      </button>
    </div>

    <p class="il__conv">Codice fornitore <strong>INNOVALUX</strong></p>

    <h1 class="il__dash-title">Prospetti impianti fotovoltaici</h1>
    <div class="il__cards">
      <a href="#preventivo" class="il__card">
        <div class="il__card-head"><Icon name="calculate" /> Nuovo prospetto</div>
        <p class="il__card-desc">Inserisci impianto e importo: canone su tutte le durate, bilancio energetico e confronto con il leasing.</p>
        <span class="il__card-link">Compila i dati &raquo;</span>
      </a>
      <a href="#risultato" class="il__card">
        <div class="il__card-head"><Icon name="description" /> I due documenti</div>
        <p class="il__card-desc">Prospetto analitico e prospetto infografico, brandizzati e pronti da consegnare al cliente finale.</p>
        <span class="il__card-link">Vai al risultato &raquo;</span>
      </a>
      <a href="#storico" class="il__card">
        <div class="il__card-head"><Icon name="receipt_long" /> Storico</div>
        <p class="il__card-desc">Tutti i prospetti generati, con i numeri e i PDF sempre riscaricabili.</p>
        <span class="il__card-link">Vedi lo storico &raquo;</span>
      </a>
    </div>

    <!-- 1. Dati del preventivo -->
    <section id="preventivo" class="il__section">
      <header class="il__section-head">
        <span class="il__section-num">1</span>
        <div>
          <h2 class="il__section-title">I dati dell'impianto</h2>
          <p class="il__section-sub">
            I campi sui consumi sono facoltativi. Se li compili con i dati della bolletta del cliente il
            calcolo usa quelli; se li lasci vuoti si applicano le ipotesi standard per la zona, e i
            prospetti lo dichiarano. La durata si può lasciare su automatica: viene proposta la più corta
            in cui il canone, al netto della deducibilità, è coperto dal risparmio in bolletta.
          </p>
        </div>
      </header>

      <form id="preventivo-form" class="il__form" novalidate>
        <div class="il__form-block">
          <p class="il__form-block-title">Cliente finale</p>
          <div class="il__grid">
            <div class="il__field il__field--full">
              <label class="il__field-label" for="cliente">Ragione sociale o nome *</label>
              <input type="text" id="cliente" name="cliente" required placeholder="Es. B Service SRL" />
            </div>
            <div class="il__field">
              <label class="il__field-label" for="comune">Comune di installazione</label>
              <input type="text" id="comune" name="comune" placeholder="Es. Baronissi" />
            </div>
            <div class="il__field">
              <label class="il__field-label" for="provincia">Provincia (sigla)</label>
              <input type="text" id="provincia" name="provincia" maxlength="2" placeholder="SA" style="text-transform:uppercase" />
            </div>
            <div class="il__field">
              <label class="il__field-label" for="forma-giuridica">Forma giuridica *</label>
              <select id="forma-giuridica" name="forma_giuridica" required>
                <option value="societa-capitali">Società di capitali (SRL, SPA, SAPA)</option>
                <option value="ditta-individuale">Ditta individuale / persona fisica con P.IVA</option>
                <option value="privato">Privato senza partita IVA</option>
              </select>
            </div>
            <div class="il__field">
              <label class="il__field-label" for="rif-preventivo">Riferimento preventivo InnovaLux</label>
              <input type="text" id="rif-preventivo" name="rif_preventivo" placeholder="Es. Preventivo del 30/07/2026" />
            </div>
          </div>
          <div id="avviso-forma" class="il__avviso" hidden>
            <span class="il__avviso-icon"><Icon name="warning" size={22} /></span>
            <div>
              <strong id="avviso-titolo"></strong>
              <p id="avviso-testo"></p>
            </div>
          </div>
        </div>

        <div class="il__form-block">
          <p class="il__form-block-title">Impianto</p>
          <div class="il__grid">
            <div class="il__field">
              <label class="il__field-label" for="kwp">Potenza fotovoltaico (kWp) *</label>
              <input type="number" id="kwp" name="kwp" min="1" step="0.1" required placeholder="20" />
            </div>
            <div class="il__field">
              <label class="il__field-label" for="kwh-accumulo">Capacità accumulo (kWh)</label>
              <input type="number" id="kwh-accumulo" name="kwh_accumulo" min="0" step="0.1" placeholder="10" />
            </div>
            <div class="il__field">
              <label class="il__field-label" for="importo">Importo chiavi in mano, IVA esclusa (€) *</label>
              <input type="number" id="importo" name="importo" min="1000" step="10" required placeholder="24980" />
            </div>
            <div class="il__field">
              <label class="il__field-label" for="installazione">Tipo di installazione</label>
              <select id="installazione" name="installazione">
                <option value="tetto">Tetto / lastrico solare</option>
                <option value="pensilina">Pensilina / tettoia</option>
                <option value="terra">A terra</option>
              </select>
            </div>
          </div>
        </div>

        <div class="il__form-block">
          <p class="il__form-block-title">Consumi del cliente (facoltativi)</p>
          <p class="il__hint">
            Li trovi sulla bolletta. Senza questi dati il prospetto resta una stima per cliente tipo e lo
            scrive nero su bianco.
          </p>
          <div class="il__grid">
            <div class="il__field">
              <label class="il__field-label" for="consumo-annuo">Consumo annuo (kWh)</label>
              <input type="number" id="consumo-annuo" name="consumo_annuo" min="0" step="100" placeholder="Es. 35000" />
            </div>
            <div class="il__field">
              <label class="il__field-label" for="prezzo-kwh">Prezzo energia (€/kWh)</label>
              <input type="number" id="prezzo-kwh" name="prezzo_kwh" min="0" step="0.01" placeholder="Es. 0,28" />
            </div>
            <div class="il__field">
              <label class="il__field-label" for="profilo">Profilo di consumo</label>
              <select id="profilo" name="profilo">
                <option value="diurno">Prevalentemente diurno</option>
                <option value="h24">Attività continua, h24</option>
              </select>
            </div>
            <div class="il__field">
              <label class="il__field-label" for="durata">Durata del noleggio</label>
              <select id="durata" name="durata">
                <option value="">Consigliata (automatica)</option>
                <option value="24">24 mesi</option>
                <option value="36">36 mesi</option>
                <option value="48">48 mesi</option>
                <option value="60">60 mesi</option>
              </select>
            </div>
          </div>
        </div>

        <div class="il__submit-row">
          <button type="submit" id="submit-btn" class="il__submit">
            <Icon name="calculate" />
            Genera i prospetti
          </button>
          <p class="il__submit-hint">
            I due PDF vengono generati subito e restano nello storico. Alberto riceve una copia via email.
          </p>
        </div>
        <div id="form-feedback" class="il__feedback" hidden></div>
      </form>
    </section>

    <!-- 2. Risultato -->
    <section id="risultato" class="il__section" hidden>
      <header class="il__section-head">
        <span class="il__section-num">2</span>
        <div>
          <h2 class="il__section-title">Il prospetto</h2>
          <p class="il__section-sub" id="risultato-sub"></p>
        </div>
      </header>
      <div id="risultato-body"></div>
    </section>

    <!-- 3. Storico -->
    <section id="storico" class="il__section">
      <header class="il__section-head">
        <span class="il__section-num">3</span>
        <div>
          <h2 class="il__section-title">I prospetti già generati</h2>
          <p class="il__section-sub">
            Restano qui con i loro numeri e i PDF riscaricabili. Quando arriva la documentazione del
            cliente, il riferimento del prospetto è quello che serve per aprire la pratica.
          </p>
        </div>
      </header>
      <div class="il__storico-bar">
        <button type="button" id="refresh-storico" class="il__refresh">
          <Icon name="refresh" />
          Aggiorna
        </button>
        <span id="storico-info" class="il__storico-info"></span>
      </div>
      <div id="storico-wrap" class="il__storico-wrap"></div>
    </section>

    <p class="il__disclaimer">
      I valori dei prospetti sono stimati e a scopo illustrativo: non costituiscono offerta vincolante né
      promessa di approvazione o di condizioni economiche. Ogni operazione è soggetta a valutazione e
      delibera degli istituti eroganti. Alberto Amà, intermediario del credito.
    </p>
  </div>
</ToolLayout>

<script>
  // Due account sul gate:
  //  - fornitore: Antonia (InnovaLux) — credenziali fisse
  //  - admin: Alberto — email MCF + chiave admin, verificata SERVER-SIDE
  //    contro EXPO_PORTAL_ADMIN_KEY (la chiave non sta nel sorgente)
  const PARTNER = 'innovalux';
  const USER_EMAIL = 'contratti@innovalux.net';
  const PASSWORD = 'innovalux';
  const ADMIN_EMAIL = 'mediocreditofacile@gmail.com';
  const KEY = 'mcf_innovalux_auth';

  type Session = { role: 'partner' | 'admin'; key: string };
  let session: Session | null = null;

  const gate = document.getElementById('gate')!;
  const tool = document.getElementById('tool')!;
  const gateUser = document.getElementById('gate-user') as HTMLInputElement;
  const gatePwd = document.getElementById('gate-pwd') as HTMLInputElement;
  const gateBtn = document.getElementById('gate-btn') as HTMLButtonElement;
  const gateError = document.getElementById('gate-error')!;
  const logoutBtn = document.getElementById('logout-btn')!;

  function showTool() {
    gate.style.display = 'none';
    tool.style.cssText = '';
    setTimeout(() => void loadStorico(), 0);
  }
  function showGate() { gate.style.display = ''; tool.style.cssText = 'display:none !important;'; }

  function loadSession(): Session | null {
    const raw = localStorage.getItem(KEY);
    if (!raw) return null;
    try {
      const s = JSON.parse(raw);
      if (s && (s.role === 'partner' || s.role === 'admin') && typeof s.key === 'string') return s;
    } catch { /* sessione corrotta: si rifa' il login */ }
    return null;
  }

  session = loadSession();
  if (session) showTool();

  function gateFail(msg: string, userBad: boolean, pwdBad: boolean) {
    gateError.textContent = msg;
    gateError.hidden = false;
    gateUser.classList.toggle('gate__input--error', userBad);
    gatePwd.classList.toggle('gate__input--error', pwdBad);
  }

  gateBtn.addEventListener('click', async () => {
    const email = gateUser.value.trim().toLowerCase();
    const pwd = gatePwd.value.trim();

    if (email === USER_EMAIL && pwd.toLowerCase() === PASSWORD) {
      session = { role: 'partner', key: PASSWORD };
    } else if (email === ADMIN_EMAIL && pwd) {
      gateBtn.disabled = true;
      gateBtn.textContent = 'Verifica...';
      try {
        const res = await fetch(`/api/preventivi-pv?partner=${PARTNER}`, { headers: { Authorization: `Bearer ${pwd}` } });
        const json = await res.json();
        if (res.ok && json.ok && json.ruolo === 'admin') session = { role: 'admin', key: pwd };
        else gateFail('Chiave admin non valida', false, true);
      } catch {
        gateFail('Verifica non riuscita, riprova', false, false);
      }
      gateBtn.disabled = false;
      gateBtn.textContent = 'Accedi';
    } else {
      gateFail('Email o password non corretti', email !== USER_EMAIL && email !== ADMIN_EMAIL, true);
    }

    if (session) {
      localStorage.setItem(KEY, JSON.stringify(session));
      gateError.hidden = true;
      gateUser.classList.remove('gate__input--error');
      gatePwd.classList.remove('gate__input--error');
      showTool();
    }
  });
  gateUser.addEventListener('keydown', (e) => { if (e.key === 'Enter') gateBtn.click(); });
  gatePwd.addEventListener('keydown', (e) => { if (e.key === 'Enter') gateBtn.click(); });
  logoutBtn.addEventListener('click', () => {
    localStorage.removeItem(KEY); session = null; showGate();
    gateUser.value = ''; gatePwd.value = ''; gateError.hidden = true;
  });

  // === Avviso sulla forma giuridica ===
  // Sta solo qui, non finisce mai nei PDF: e' un controllo per chi compila.
  const AVVISI: Record<string, { titolo: string; testo: string; grave: boolean }> = {
    privato: {
      titolo: 'Il noleggio operativo non è percorribile',
      testo: 'Per un privato senza partita IVA la strada è la detrazione fiscale del 50 per cento in dieci quote annuali. Il prospetto si può comunque generare come confronto, ma la pratica di noleggio non si apre.',
      grave: true,
    },
    'ditta-individuale': {
      titolo: 'Da verificare prima di procedere',
      testo: 'Servono partita IVA attiva e destinazione strumentale dell\'impianto. Occhio all\'utenza: un impianto su immobile a uso abitativo con utenza domestica non regge una pratica intestata a un\'attività.',
      grave: false,
    },
  };

  const formaGiuridica = document.getElementById('forma-giuridica') as HTMLSelectElement;
  const avviso = document.getElementById('avviso-forma')!;
  const avvisoTitolo = document.getElementById('avviso-titolo')!;
  const avvisoTesto = document.getElementById('avviso-testo')!;

  function aggiornaAvviso() {
    const a = AVVISI[formaGiuridica.value];
    if (!a) { avviso.hidden = true; return; }
    avvisoTitolo.textContent = a.titolo;
    avvisoTesto.textContent = a.testo;
    avviso.classList.toggle('il__avviso--grave', a.grave);
    avviso.hidden = false;
  }
  formaGiuridica.addEventListener('change', aggiornaAvviso);
  aggiornaAvviso();

  // === Formattazione ===
  const eur = (v: number, dec = 0) =>
    v.toLocaleString('it-IT', { minimumFractionDigits: dec, maximumFractionDigits: dec, useGrouping: 'always' }) + ' €';
  const num = (v: number, dec = 0) =>
    v.toLocaleString('it-IT', { minimumFractionDigits: dec, maximumFractionDigits: dec, useGrouping: 'always' });
  const pct = (v: number) => `${Math.round(v * 100)}%`;

  // === Generazione preventivo ===
  const form = document.getElementById('preventivo-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const feedback = document.getElementById('form-feedback')!;
  const sezioneRisultato = document.getElementById('risultato') as HTMLElement;
  const risultatoSub = document.getElementById('risultato-sub')!;
  const risultatoBody = document.getElementById('risultato-body')!;

  function mostraFeedback(testo: string, ok: boolean) {
    feedback.textContent = testo;
    feedback.className = `il__feedback il__feedback--${ok ? 'ok' : 'err'}`;
    feedback.hidden = false;
  }

  // I PDF stanno su uno store privato: il download passa da una fetch con il
  // bearer di sessione, non da un <a download> (che l'header non lo manda).
  function linkDoc(pathname: string, nome: string): string {
    const etichetta = nome.includes('Infografico') ? 'Prospetto infografico' : 'Prospetto analitico';
    return `<button type="button" class="il__pdf" data-doc="${encodeURIComponent(pathname)}" data-nome="${nome.replace(/"/g, '')}">${etichetta}</button>`;
  }

  async function scaricaDoc(pathname: string, nome: string, bottone: HTMLButtonElement) {
    if (!session) return;
    const originale = bottone.textContent;
    bottone.disabled = true;
    bottone.textContent = 'Scarico...';
    try {
      const res = await fetch(`/api/pratica-doc?path=${encodeURIComponent(pathname)}`, {
        headers: { Authorization: `Bearer ${session.key}` },
      });
      if (!res.ok) throw new Error(String(res.status));
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = nome;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } catch {
      bottone.textContent = 'Download non riuscito';
      setTimeout(() => { bottone.textContent = originale; }, 2500);
      bottone.disabled = false;
      return;
    }
    bottone.textContent = originale;
    bottone.disabled = false;
  }

  document.addEventListener('click', (e) => {
    const bottone = (e.target as HTMLElement)?.closest?.('[data-doc]') as HTMLButtonElement | null;
    if (!bottone) return;
    void scaricaDoc(decodeURIComponent(bottone.dataset.doc!), bottone.dataset.nome ?? 'prospetto.pdf', bottone);
  });

  function renderRisultato(res: any) {
    const n = res.numeri;
    // le durate arrivano dal server: le quota l'operatore, non la pagina
    const durateRighe = Object.keys(n.canoni).map(Number).sort((a, b) => a - b)
      .map((m) => `
        <tr class="${m === n.durata ? 'il__riga-scelta' : ''}">
          <td>${m} mesi</td>
          <td>${eur(n.canoni[m], 2)}</td>
          <td>${eur(n.riscatti[m], 2)}</td>
        </tr>`)
      .join('');

    const notaDurata = n.durataForzata
      ? `Durata impostata a ${n.durata} mesi. Quella consigliata su questo impianto sarebbe ${n.durataConsigliata}.`
      : `Durata consigliata: ${n.durata} mesi, la più corta in cui il canone al netto della deducibilità è coperto dal risparmio in bolletta.`;

    const pdfBlocco = res.pdfPronti
      ? `<div class="il__pdf-row">${res.documenti.map((d: any) => linkDoc(d.pathname, d.nome)).join('')}</div>`
      : `<p class="il__feedback il__feedback--err" style="margin-top:1rem">
           I numeri qui sopra sono validi, ma i PDF non sono ancora pronti: il servizio di generazione non
           ha risposto. Riprova tra qualche minuto, il preventivo resta salvato nello storico.
         </p>`;

    risultatoSub.textContent = notaDurata;
    risultatoBody.innerHTML = `
      <div class="il__kpi">
        <div class="il__kpi-card">
          <span class="il__kpi-num">${eur(n.canone, 2)}</span>
          <span class="il__kpi-label">canone mensile, ${n.durata} mesi</span>
        </div>
        <div class="il__kpi-card">
          <span class="il__kpi-num">${eur(n.beneficioMese, 0)}</span>
          <span class="il__kpi-label">risparmio in bolletta al mese</span>
        </div>
        <div class="il__kpi-card">
          <span class="il__kpi-num">${pct(n.coperturaCanone)}</span>
          <span class="il__kpi-label">del canone coperto dal sole</span>
        </div>
        <div class="il__kpi-card ${n.margineMese >= 0 ? 'il__kpi-card--ok' : ''}">
          <span class="il__kpi-num">${n.margineMese >= 0 ? '+' : ''}${eur(n.margineMese, 0)}</span>
          <span class="il__kpi-label">al mese dopo la deducibilità</span>
        </div>
      </div>

      <div class="il__due-col">
        <div class="il__box">
          <p class="il__box-title">Canoni per durata</p>
          <table class="il__table">
            <thead><tr><th>Durata</th><th>Canone mensile</th><th>Riscatto indicativo</th></tr></thead>
            <tbody>${durateRighe}</tbody>
          </table>
        </div>
        <div class="il__box">
          <p class="il__box-title">Energia e fisco</p>
          <table class="il__table">
            <tbody>
              <tr><td>Produzione stimata</td><td>${num(n.produzione)} kWh/anno</td></tr>
              <tr><td>Autoconsumo</td><td>${num(n.autoKwh)} kWh (${pct(n.autoconsumoQuota)})</td></tr>
              <tr><td>Ceduta in rete</td><td>${num(n.cedKwh)} kWh</td></tr>
              <tr><td>Beneficio energetico</td><td>${eur(n.beneficioAnno)}/anno</td></tr>
              <tr><td>Risparmio fiscale sul canone</td><td>${eur(n.fiscoNol)}</td></tr>
              <tr><td>Costo netto del noleggio</td><td>${eur(n.costoNettoNol)}</td></tr>
            </tbody>
          </table>
        </div>
        <div class="il__box">
          <p class="il__box-title">Confronto con il leasing</p>
          <table class="il__table">
            <tbody>
              <tr><td>Rata leasing, ${n.durata} mesi</td><td>${eur(n.rataLeasing, 2)}</td></tr>
              <tr><td>Interessi</td><td>${eur(n.interessi)}</td></tr>
              <tr><td>Contributo Nuova Sabatini Green</td><td>${eur(n.sabatini)}</td></tr>
              <tr><td>Risparmio IRES da iperammortamento</td><td>${eur(n.iresIper)}</td></tr>
              <tr><td>Costo netto del leasing agevolato</td><td>${eur(n.costoNettoLeasing)}</td></tr>
            </tbody>
          </table>
          <p class="il__box-nota">
            Sabatini e iperammortamento valgono solo sul leasing: sul noleggio operativo non si applicano.
          </p>
        </div>
      </div>

      ${pdfBlocco}
    `;
    sezioneRisultato.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!session) return;

    const dati = Object.fromEntries(new FormData(form).entries());
    if (!dati.cliente || !dati.kwp || !dati.importo) {
      mostraFeedback('Servono almeno cliente, potenza e importo.', false);
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Genero i prospetti...';
    feedback.hidden = true;

    try {
      const res = await fetch('/api/preventivo-innovalux', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session.key}` },
        body: JSON.stringify({ input: dati }),
      });
      const json = await res.json();
      if (!res.ok || !json.ok) {
        mostraFeedback('Generazione non riuscita. Controlla i dati e riprova.', false);
      } else {
        renderRisultato(json);
        mostraFeedback(
          json.pdfPronti
            ? `Prospetti generati (${json.id}). Li trovi qui sotto e nello storico.`
            : `Numeri calcolati (${json.id}), PDF in ritardo: il preventivo è salvato, riprova tra poco.`,
          json.pdfPronti,
        );
        void loadStorico();
        document.getElementById('risultato')?.scrollIntoView({ behavior: 'smooth' });
      }
    } catch {
      mostraFeedback('Connessione non riuscita. Riprova.', false);
    }

    submitBtn.disabled = false;
    submitBtn.textContent = 'Genera i prospetti';
  });

  // === Storico ===
  const storicoWrap = document.getElementById('storico-wrap')!;
  const storicoInfo = document.getElementById('storico-info')!;
  document.getElementById('refresh-storico')!.addEventListener('click', () => void loadStorico());

  async function loadStorico() {
    if (!session) return;
    storicoInfo.textContent = 'Carico...';
    try {
      const res = await fetch(`/api/preventivi-pv?partner=${PARTNER}`, {
        headers: { Authorization: `Bearer ${session.key}` },
      });
      const json = await res.json();
      if (!res.ok || !json.ok) {
        storicoInfo.textContent = 'Storico non disponibile';
        return;
      }

      const lista = json.preventivi ?? [];
      storicoInfo.textContent = lista.length === 1 ? '1 prospetto' : `${lista.length} prospetti`;

      if (!lista.length) {
        storicoWrap.innerHTML = '<p class="il__storico-empty">Nessun prospetto generato finora.</p>';
        return;
      }

      storicoWrap.innerHTML = `
        <table class="il__table il__table--storico">
          <thead>
            <tr><th>Data</th><th>Cliente</th><th>Impianto</th><th>Canone</th><th>Documenti</th></tr>
          </thead>
          <tbody>
            ${lista.map((p: any) => {
              const data = new Date(p.creato).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: 'numeric' });
              const doc = (p.documenti ?? []).map((d: any) => linkDoc(d.pathname, d.nome)).join('');
              return `
                <tr>
                  <td>${data}<br><span class="il__id">${p.id}</span></td>
                  <td>${p.cliente?.nome ?? '-'}<br><span class="il__id">${[p.cliente?.comune, p.cliente?.provincia].filter(Boolean).join(' ')}</span></td>
                  <td>${num(p.impianto?.kwp ?? 0, 0)} kWp${p.impianto?.kwh_accumulo ? ` + ${num(p.impianto.kwh_accumulo, 0)} kWh` : ''}<br><span class="il__id">${eur(p.impianto?.importo ?? 0)}</span></td>
                  <td>${eur(p.numeri?.canone ?? 0, 2)}<br><span class="il__id">${p.numeri?.durata ?? '-'} mesi</span></td>
                  <td>${doc || '<span class="il__id">PDF non generati</span>'}</td>
                </tr>`;
            }).join('')}
          </tbody>
        </table>`;
    } catch {
      storicoInfo.textContent = 'Storico non disponibile';
    }
  }
</script>

