---
import Icon from '../../components/Icon.astro';
/**
 * Portale Partner STILO S.R.L. — /tools/stilo
 * Stessa struttura del portale Expo Energia (stesso motore condiviso):
 * - accessi personali (Better Auth, come Green-Go) dal 13/10/2026: Paolo Bonardi e'
 *   il referente e vede tutte le pratiche, i collaboratori che invita vedono solo
 *   le proprie, MCF entra da admin. Prima c'era una password condivisa.
 * - dashboard con card in stile ReteRent (Simulazioni / Preventivi / Richieste)
 * - simulatore su tabella Pioneer: centralini telefonici e hardware di rete
 * - form di caricamento pratica con checklist documenti dinamica e upload allegati
 * Lead vanno a /api/submit-stilo (mail dettagliata + Zapier), lista e documenti
 * da /api/portale-pratiche, upload da /api/portale-upload.
 *
 * Ratio interna (non esposta in pagina): STILO e' attivabile su due canali,
 * BCC Rent & Lease (rapida su telefonia e server, esclude Horeca ed edilizia)
 * e Grenke / ReteRent con tabella Pioneer. La rotazione la decide Alberto in
 * base alla categoria del cliente finale e al merito creditizio.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import SimulatorePortale from '../../components/tools/SimulatorePortale.tsx';
---
<ToolLayout
  title="Portale STILO — Simulazioni e Pratiche | Mediocredito Facile"
  description="Portale riservato STILO S.R.L.: simulazione canoni di noleggio operativo per centralini telefonici e hardware di rete, caricamento pratiche cliente."
  noindex={true}
  breadcrumbs={[{ name: 'Portale STILO', href: '/tools/stilo' }]}
>
  <!-- Gate: accesso personale, recupero password, attivazione invito (src/scripts/motore/gate.ts) -->
  <div id="gate" class="gate">
    <div class="gate__card">
      <div class="gate__logos">
        <img src="/images/logo-mediocreditofacile.webp" alt="Mediocredito Facile" class="gate__logo" />
        <span class="gate__x">&times;</span>
        <span class="gate__partner-name">STILO S.R.L.</span>
      </div>
      <div class="gate__divider"></div>

      <div id="vista-login">
        <p class="gate__label">Portale Riservato Partner</p>
        <p class="gate__desc">Simulazione canoni di noleggio operativo per centralini telefonici e hardware di rete, e caricamento pratiche cliente.</p>
        <div class="gate__form">
          <input type="email" id="login-email" class="gate__input" placeholder="La tua email" autocomplete="username" />
          <input type="password" id="login-pwd" class="gate__input" placeholder="Password" autocomplete="current-password" />
          <button id="login-btn" class="gate__btn">
            <Icon name="lock_open" />
            Accedi
          </button>
        </div>
        <p class="gate__links"><button type="button" id="vai-recupero" class="gate__link">Ho dimenticato la password</button></p>
        <p class="gate__nota">
          Dal 13 ottobre ognuno entra con il proprio accesso, non più con la password comune. Se non l'hai
          ancora attivato, cerca nella posta l'invito di Mediocredito Facile.
        </p>
      </div>

      <div id="vista-recupero" hidden>
        <p class="gate__label">Password dimenticata</p>
        <p class="gate__desc">Inserisci la tua email: ti arriva un link per sceglierne una nuova. Vale un'ora.</p>
        <div class="gate__form">
          <input type="email" id="recupero-email" class="gate__input" placeholder="La tua email" autocomplete="username" />
          <button id="recupero-btn" class="gate__btn">Mandami il link</button>
        </div>
        <p class="gate__links"><button type="button" id="torna-login" class="gate__link">Torna all'accesso</button></p>
      </div>

      <div id="vista-nuova-password" hidden>
        <p class="gate__label">Scegli la nuova password</p>
        <p class="gate__desc">Almeno dieci caratteri. È personale, non va condivisa.</p>
        <div class="gate__form">
          <input type="password" id="nuova-pwd" class="gate__input" placeholder="Nuova password" autocomplete="new-password" />
          <button id="nuova-pwd-btn" class="gate__btn">Salva e accedi</button>
        </div>
      </div>

      <div id="vista-invito" hidden>
        <p class="gate__label">Attiva il tuo accesso</p>
        <p class="gate__desc" id="invito-desc"></p>
        <div class="gate__form">
          <input type="text" id="invito-nome" class="gate__input" placeholder="Nome e cognome" autocomplete="name" />
          <input type="password" id="invito-pwd" class="gate__input" placeholder="Scegli una password" autocomplete="new-password" />
          <button id="invito-btn" class="gate__btn">Entra nel portale</button>
        </div>
        <p class="gate__nota" id="invito-nota"></p>
      </div>

      <p id="gate-errore" class="gate__error" hidden></p>
      <p id="gate-ok" class="gate__ok" hidden></p>
    </div>
  </div>

  <!-- Portale (nascosto fino ad autenticazione) -->
  <div id="tool" class="st" hidden>
    <!-- Header co-branded -->
    <div class="st__header">
      <div class="st__header-brand">
        <img src="/images/logo-mediocreditofacile.webp" alt="Mediocredito Facile" class="st__logo" />
        <div class="st__header-sep"></div>
        <div class="st__partner-badge">
          <Icon name="phone" class="st__partner-icon" />
          <span class="st__partner-label">STILO S.R.L.</span>
        </div>
      </div>
      <div class="st__header-destra">
        <span id="chi-sono" class="st__chi"></span>
        <button id="logout-btn" class="st__logout">
          <Icon name="logout" />
          Esci
        </button>
      </div>
    </div>

    <!-- Riga codice partner, come il "Codice Convenzione" ReteRent -->
    <p class="st__conv">Codice partner <strong>STILO</strong></p>

    <!-- Dashboard card -->
    <h1 class="st__dash-title">Gestione offerte di noleggio</h1>
    <div class="st__cards">
      <a href="#simulatore" class="st__card">
        <div class="st__card-head"><Icon name="calculate" /> Simulazioni</div>
        <p class="st__card-desc">Calcola i canoni di noleggio a partire dal prezzo di vendita, oppure parti dal canone per ottenere il prezzo.</p>
        <span class="st__card-link">Nuova simulazione &raquo;</span>
      </a>
      <a href="#simulatore" class="st__card">
        <div class="st__card-head"><Icon name="description" /> Preventivi</div>
        <p class="st__card-desc">Stampa la simulazione in versione pulita, pronta da consegnare o inviare al cliente.</p>
        <span class="st__card-link">Stampa simulazione &raquo;</span>
      </a>
      <div class="st__card">
        <div class="st__card-head"><Icon name="send" /> Richieste</div>
        <p class="st__card-desc">Trasmetti la pratica con i documenti del cliente allegati e controlla lo stato di quelle già inviate.</p>
        <span>
          <a class="st__card-link" href="#pratica">Carica una pratica &raquo;</a><br />
          <a class="st__card-link" href="#lista-pratiche">Lista richieste &raquo;</a>
        </span>
      </div>
      <a href="#documenti" class="st__card">
        <div class="st__card-head"><Icon name="checklist" /> Documenti</div>
        <p class="st__card-desc">La checklist dei documenti si aggiorna da sola in base a importo e forma giuridica del cliente.</p>
        <span class="st__card-link">Vedi checklist &raquo;</span>
      </a>
    </div>

    <!-- 1. Simulatore -->
    <section id="simulatore" class="st__section">
      <header class="st__section-head">
        <span class="st__section-num">1</span>
        <div>
          <h2 class="st__section-title">Simula i canoni</h2>
          <p class="st__section-sub">
            Cinque formule a confronto per centralini, hardware di rete e apparati di telefonia: noleggio
            Grenke, locazione operativa, leasing e finanziamento BCC, piu' la campagna a tasso zero in dieci
            rate. Scegli il prodotto dal menu e confronta la rata. L'importo definitivo viene confermato
            dopo la delibera.
          </p>
        </div>
      </header>
      <SimulatorePortale
        client:load
        tabelle={['pioneer', 'bcc-lo', 'bcc-lf', 'bcc-ff', 'bcc-zero']}
        partner="STILO S.R.L."
        classeBcc={3}
        etichetteBene={{
          pioneer: 'Centralino telefonico / hardware di rete',
          'bcc-lo': 'Centralino telefonico / hardware di rete',
          'bcc-lf': 'Centralino telefonico / hardware di rete',
          'bcc-ff': 'Centralino telefonico / hardware di rete',
          'bcc-zero': 'Centralino telefonico / hardware di rete',
        }}
      />
    </section>

    <!-- 2. Carica pratica -->
    <section id="pratica" class="st__section">
      <header class="st__section-head">
        <span class="st__section-num">2</span>
        <div>
          <h2 class="st__section-title">Carica una pratica</h2>
          <p class="st__section-sub">
            Compila i dati del cliente finale e del bene. La checklist documenti qui sotto si aggiorna mentre scrivi:
            chiede solo quello che serve per quell'importo e quella forma giuridica.
          </p>
        </div>
      </header>

      <form id="pratica-form" class="st__form" novalidate>
        <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true" />

        <div class="st__form-block">
          <h3 class="st__form-block-title">Cliente finale</h3>
          <div class="st__grid">
            <label class="st__field st__field--full">
              <span class="st__field-label">Ragione sociale / Nominativo *</span>
              <input type="text" name="ragione_sociale" required placeholder="Es. Studio Rossi SRL" />
            </label>

            <label class="st__field">
              <span class="st__field-label">Forma giuridica *</span>
              <select name="forma_giuridica" id="forma-giuridica" required>
                <option value="">Seleziona</option>
                <option value="Ditta Individuale">Ditta Individuale</option>
                <option value="SRL">SRL</option>
                <option value="SRLS">SRL Semplificata</option>
                <option value="SPA">SPA</option>
                <option value="SNC">SNC</option>
                <option value="SAS">SAS</option>
                <option value="Lavoratore Autonomo">Lavoratore Autonomo</option>
                <option value="Cooperativa">Cooperativa</option>
              </select>
            </label>

            <label class="st__field">
              <span class="st__field-label">Partita IVA / CF</span>
              <input type="text" name="piva" placeholder="11 cifre" inputmode="numeric" />
            </label>

            <label class="st__field">
              <span class="st__field-label">Referente</span>
              <input type="text" name="referente" placeholder="Nome e cognome" />
            </label>

            <label class="st__field">
              <span class="st__field-label">Cellulare del referente *</span>
              <input type="tel" name="telefono" required placeholder="+39 333 1234567" />
            </label>

            <label class="st__field st__field--full">
              <span class="st__field-label">Email del referente *</span>
              <input type="email" name="email" required placeholder="cliente@esempio.it" />
            </label>

            <label class="st__field st__field--full">
              <span class="st__field-label">IBAN del conto aziendale *</span>
              <input type="text" name="iban" class="st__iban" required autocomplete="off" spellcheck="false" maxlength="48"
                placeholder="27 caratteri, inizia con IT" aria-describedby="iban-esito" />
              <span class="st__field-hint">Quello su cui il cliente pagherà i canoni. Senza IBAN la pratica non parte.</span>
              <span class="st__field-error" id="iban-esito" data-iban-esito role="alert" hidden></span>
            </label>
          </div>
        </div>

        <div class="st__form-block">
          <h3 class="st__form-block-title">Beni da noleggiare</h3>
          <p class="st__beni-hint">Aggiungi tutti i beni del contratto: il canone si calcola sul totale imponibile.</p>

          <div id="beni-rows" class="st__beni">
            <div class="bene-row st__bene-row">
              <label class="st__field">
                <span class="st__field-label">Tipologia</span>
                <select data-bene="tipologia">
                  <option value="Centralino telefonico" selected>Centralino telefonico</option>
                  <option value="Hardware di rete">Hardware di rete (switch, router, access point)</option>
                  <option value="Telefoni e apparati">Telefoni e apparati VoIP</option>
                  <option value="Altro">Altro bene strumentale</option>
                </select>
              </label>
              <label class="st__field st__field--grow">
                <span class="st__field-label">Descrizione bene *</span>
                <input type="text" data-bene="descrizione" required placeholder="Es. Centralino IP 32 interni + 12 telefoni VoIP" />
              </label>
              <label class="st__field st__field--importo">
                <span class="st__field-label">Importo (€) *</span>
                <input type="number" data-bene="importo" required min="0" step="100" placeholder="12000" />
              </label>
              <button type="button" class="st__bene-remove" data-bene-remove aria-label="Rimuovi bene">&times;</button>
            </div>
          </div>

          <div class="st__beni-bar">
            <button type="button" id="beni-add" class="st__beni-add">
              <Icon name="add" /> Aggiungi bene
            </button>
            <div class="st__beni-total-wrap">Totale imponibile <strong id="beni-total">0,00 €</strong></div>
          </div>

          <input type="hidden" name="beni" id="beni-json" />
          <input type="hidden" name="importo" id="importo" />

          <div class="st__grid st__grid--contratto">
            <label class="st__field">
              <span class="st__field-label">Durata noleggio (mesi)</span>
              <select name="durata">
                <option value="24">24 mesi</option>
                <option value="30">30 mesi</option>
                <option value="36">36 mesi</option>
                <option value="48">48 mesi</option>
                <option value="60" selected>60 mesi</option>
              </select>
            </label>

            <label class="st__field">
              <span class="st__field-label">Canone simulato (€/mese)</span>
              <input type="number" name="canone_simulato" min="0" step="1" placeholder="Dal simulatore qui sopra" />
            </label>

            <label class="st__field st__field--full">
              <span class="st__field-label">Note (opzionale)</span>
              <textarea name="note" rows="3" placeholder="Contesto del cliente, urgenza, dettagli dell'installazione..."></textarea>
            </label>
          </div>
        </div>

        <!-- Checklist documenti dinamica -->
        <div id="documenti" class="st__form-block">
          <h3 class="st__form-block-title">Documenti da raccogliere</h3>

          <div id="checklist-banner" class="st__banner st__banner--base">
            <Icon name="info" class="st__banner-icon" />
            <div>
              <strong id="banner-title">Documenti base</strong>
              <p id="banner-sub">Per importi fino a 10.000 € bastano i documenti standard. Sopra i 10.000 € la società di noleggio chiede anche i reddituali.</p>
            </div>
          </div>

          <table class="st__table">
            <thead>
              <tr>
                <th>Documento</th>
                <th class="st__th-when">Quando serve</th>
              </tr>
            </thead>
            <tbody id="checklist-body">
              <tr><td>Visura camerale (o visura ditta individuale)</td><td>Sempre</td></tr>
              <tr><td>Carta d'identita' del legale rappresentante / titolare</td><td>Sempre</td></tr>
              <tr><td>Tessera sanitaria / codice fiscale</td><td>Sempre</td></tr>
              <tr><td>Coordinate IBAN aziendali</td><td>Sempre</td></tr>
              <tr><td>Email aziendale</td><td>Sempre</td></tr>
              <tr><td>Cellulare del referente</td><td>Sempre</td></tr>
              <tr><td>Offerta / preventivo al cliente finale</td><td>Sempre</td></tr>
              <tr class="st__row-extra" data-extra="di" hidden>
                <td>Ultime 2 dichiarazioni dei redditi (Modello Unico)</td>
                <td>Solo Ditta Individuale, importo &gt; 10.000 €</td>
              </tr>
              <tr class="st__row-extra" data-extra="di" hidden>
                <td>Situazione contabile aggiornata 2025</td>
                <td>Solo Ditta Individuale, importo &gt; 10.000 €</td>
              </tr>
              <tr class="st__row-extra" data-extra="srl" hidden>
                <td>Ultimi 2 bilanci depositati</td>
                <td>Solo societa' di capitali, importo &gt; 10.000 €</td>
              </tr>
              <tr class="st__row-extra" data-extra="srl" hidden>
                <td>Bilancio definitivo 2025 (anche pre-deposito)</td>
                <td>Solo societa' di capitali, importo &gt; 10.000 €</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Upload documenti -->
        <div class="st__form-block">
          <h3 class="st__form-block-title">Allega i documenti</h3>
          <p class="st__upload-hint">
            PDF, immagini, visure firmate (.p7m), Word ed Excel — massimo 25 MB a file.
            Puoi inviare la pratica anche senza documenti e integrarli in un secondo momento.
          </p>
          <label class="st__upload-drop" for="file-input">
            <Icon name="upload_file" class="st__upload-icon" />
            <span><strong>Scegli i file da allegare</strong> oppure trascinali qui</span>
            <input type="file" id="file-input" multiple accept=".pdf,.jpg,.jpeg,.png,.heic,.p7m,.doc,.docx,.xls,.xlsx" hidden />
          </label>
          <ul id="file-list" class="st__file-list"></ul>
        </div>

        <div class="st__submit-row">
          <button type="submit" class="st__submit">
            <Icon name="send" />
            Invia pratica
          </button>
          <p class="st__submit-hint">
            Riceviamo pratica e documenti in tempo reale. Ti richiamiamo al telefono indicato per la conferma e vedi l'avanzamento nella lista richieste qui sotto.
          </p>
        </div>

        <div id="form-feedback" class="st__feedback" hidden></div>
      </form>
    </section>

    <!-- 3. Le tue richieste (id diverso da "richieste": quello e' delle richieste di accesso della rete) -->
    <section id="lista-pratiche" class="st__section">
      <header class="st__section-head">
        <span class="st__section-num">3</span>
        <div>
          <h2 class="st__section-title">Le tue richieste</h2>
          <p class="st__section-sub" id="richieste-sub">
            Le pratiche trasmesse, con documenti e stato di avanzamento. Lo stato lo aggiorna Mediocredito Facile man mano che la pratica avanza.
          </p>
        </div>
      </header>

      <div class="st__richieste-bar">
        <button type="button" id="refresh-richieste" class="st__refresh">
          <Icon name="refresh" />
          Aggiorna
        </button>
        <span id="richieste-info" class="st__richieste-info"></span>
      </div>

      <div id="richieste-wrap" class="st__richieste-wrap">
        <p class="st__richieste-empty">Caricamento in corso...</p>
      </div>
    </section>

    <!-- 4. La tua rete: solo referente e MCF (src/scripts/motore/rete.ts, API /api/portale-utenti) -->
    <section id="rete" class="st__section" hidden>
      <header class="st__section-head">
        <span class="st__section-num">4</span>
        <div>
          <h2 class="st__section-title">La tua rete</h2>
          <p class="st__section-sub">
            Chi lavora sul portale per STILO. Ogni collaboratore riceve un invito via email, sceglie la propria
            password e vede solo le pratiche che carica; tu le vedi tutte. Da qui lo inviti e, quando serve,
            sospendi il suo accesso.
          </p>
        </div>
      </header>

      <div class="st__form-block">
        <h3 class="st__form-block-title">Invita un collaboratore</h3>
        <div class="st__grid">
          <label class="st__field">
            <span class="st__field-label">Nome e cognome</span>
            <input type="text" id="inv-nome" autocomplete="off" />
          </label>
          <label class="st__field">
            <span class="st__field-label">Email</span>
            <input type="email" id="inv-email" autocomplete="off" />
          </label>
        </div>
        <div class="st__rete-azioni">
          <button type="button" id="inv-btn" class="st__refresh">
            <Icon name="send" />
            Invita
          </button>
          <span class="st__rete-nota">L'invito parte col giro delle 7; per mandarlo subito usa "Manda ora" nella lista qui sotto.</span>
        </div>
        <p id="rete-msg" class="mt-msg" hidden></p>
      </div>

      <div id="richieste-blocco" hidden>
        <h3 class="st__rete-titolo">Richieste di accesso</h3>
        <div id="richieste"></div>
      </div>
      <h3 class="st__rete-titolo">Chi ha accesso</h3>
      <div id="membri"></div>
      <h3 class="st__rete-titolo">Inviti</h3>
      <div id="inviti"></div>
    </section>
  </div>
</ToolLayout>

<script>
  import { upload } from '@vercel/blob/client';
  import { initBeniRows } from '../../scripts/beni-rows';
  import { initDatiCliente } from '../../scripts/dati-cliente-form';
  import { apiJson, stato as statoPortale } from '../../scripts/motore/comune';
  import { avviaGate } from '../../scripts/motore/gate';
  import { caricaRete, montaRete } from '../../scripts/motore/rete';

  // Accessi personali dal 13/10/2026, come Green-Go: ognuno entra con la sua
  // email e la password scelta dall'invito. Il ruolo e le pratiche visibili li
  // decide il server dalla sessione (/api/portale-pratiche): qui non c'e'
  // nessuna password e nessun controllo che conti, solo cosa mostrare.
  //  - referente (Paolo Bonardi): tutte le pratiche STILO e la sezione rete
  //  - agente (i collaboratori che invita): solo le pratiche che carica
  //  - admin (MCF): tutto, e cambia gli stati
  const PARTNER = 'stilo';
  const PERCORSO = '/tools/stilo';
  const URL_PRATICHE = `/api/portale-pratiche?partner=${PARTNER}`;

  type Accesso = {
    ruolo: 'admin' | 'referente' | 'agente';
    vedeTutto: boolean;
    utente: { id: string; nome: string; email: string };
  };
  let accesso: Accesso | null = null;

  const gate = document.getElementById('gate')!;
  const tool = document.getElementById('tool')!;

  // La sessione della vecchia password condivisa non serve piu'
  try { localStorage.removeItem('mcf_stilo_auth'); } catch { /* storage bloccato */ }

  /** La sessione e' scaduta mentre si lavorava: si torna all'accesso, il modulo resta compilato */
  function sessioneScaduta() {
    accesso = null;
    tool.hidden = true;
    gate.hidden = false;
  }

  let reteMontata = false;

  /** Chiamata dal gate quando /api/portale-pratiche risponde ok */
  function entra(corpo: any) {
    accesso = { ruolo: corpo.ruolo, vedeTutto: Boolean(corpo.vedeTutto), utente: corpo.utente };
    statoPortale.slug = PARTNER;
    statoPortale.ruolo = corpo.ruolo;
    statoPortale.vedeTutto = accesso.vedeTutto;
    statoPortale.utente = corpo.utente;

    const etichetta = corpo.ruolo === 'referente' ? ' · referente' : corpo.ruolo === 'admin' ? ' · MCF' : '';
    document.getElementById('chi-sono')!.textContent = `${corpo.utente?.nome || corpo.utente?.email || ''}${etichetta}`;
    document.getElementById('richieste-sub')!.textContent = accesso.vedeTutto
      ? 'Tutte le pratiche STILO, con chi le ha caricate, i documenti e lo stato. Lo stato lo aggiorna Mediocredito Facile man mano che la pratica avanza.'
      : 'Le pratiche che hai caricato tu, con documenti e stato. Lo stato lo aggiorna Mediocredito Facile man mano che la pratica avanza.';

    const rete = document.getElementById('rete')!;
    rete.hidden = !accesso.vedeTutto;
    if (accesso.vedeTutto) {
      if (!reteMontata) { montaRete({ conPreventivi: false }); reteMontata = true; }
      void caricaRete();
    }
    renderRichieste(corpo.pratiche ?? []);
  }

  // === Checklist dinamica (stessa logica dell'area Edilizia GIERRE) ===
  const formaGiuridica = document.getElementById('forma-giuridica') as HTMLSelectElement;
  const importoInput = document.getElementById('importo') as HTMLInputElement;
  const banner = document.getElementById('checklist-banner')!;
  const bannerTitle = document.getElementById('banner-title')!;
  const bannerSub = document.getElementById('banner-sub')!;
  const extraRows = document.querySelectorAll<HTMLTableRowElement>('.st__row-extra');

  const FORMA_DI = ['Ditta Individuale', 'Lavoratore Autonomo'];

  function updateChecklist() {
    const importo = parseFloat(importoInput.value) || 0;
    const fg = formaGiuridica.value;
    const sopraSoglia = importo > 10000;
    const isDi = FORMA_DI.includes(fg);
    const isSocieta = fg && !isDi;

    extraRows.forEach((row) => {
      const tag = row.dataset.extra;
      let show = false;
      if (sopraSoglia) {
        if (tag === 'di' && isDi) show = true;
        if (tag === 'srl' && isSocieta) show = true;
      }
      row.hidden = !show;
    });

    banner.classList.remove('st__banner--base', 'st__banner--full');
    if (sopraSoglia && fg) {
      banner.classList.add('st__banner--full');
      bannerTitle.textContent = `Documenti completi (${isDi ? 'Ditta Individuale' : 'Societa\' di capitali'})`;
      bannerSub.textContent = isDi
        ? 'Importo sopra 10.000 €: oltre ai documenti base servono le ultime 2 dichiarazioni dei redditi e la situazione contabile 2025.'
        : 'Importo sopra 10.000 €: oltre ai documenti base servono gli ultimi 2 bilanci depositati e il bilancio definitivo 2025.';
    } else if (sopraSoglia && !fg) {
      banner.classList.add('st__banner--base');
      bannerTitle.textContent = 'Seleziona la forma giuridica';
      bannerSub.textContent = 'Sopra 10.000 € la documentazione reddituale cambia tra Ditta Individuale e Societa\' di capitali. Scegli la forma giuridica per la lista esatta.';
    } else {
      banner.classList.add('st__banner--base');
      bannerTitle.textContent = 'Documenti base';
      bannerSub.textContent = 'Per importi fino a 10.000 € bastano i documenti standard. Sopra i 10.000 € la società di noleggio chiede anche i reddituali.';
    }
  }

  formaGiuridica.addEventListener('change', updateChecklist);
  importoInput.addEventListener('input', updateChecklist);

  // === Distinta beni (una pratica = un contratto con piu' beni) ===
  initBeniRows();

  // === Gestione file selezionati ===
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileList = document.getElementById('file-list')!;
  const MAX_FILE_BYTES = 25 * 1024 * 1024;
  let selectedFiles: File[] = [];

  function fmtSize(n: number): string {
    return n > 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.round(n / 1024)} KB`;
  }

  function renderFileList() {
    fileList.innerHTML = '';
    selectedFiles.forEach((f, i) => {
      const li = document.createElement('li');
      li.className = 'st__file-item';
      const name = document.createElement('span');
      name.className = 'st__file-name';
      name.textContent = `${f.name} (${fmtSize(f.size)})`;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'st__file-remove';
      btn.textContent = 'Rimuovi';
      btn.addEventListener('click', () => { selectedFiles.splice(i, 1); renderFileList(); });
      li.append(name, btn);
      fileList.appendChild(li);
    });
  }

  function addFiles(files: FileList | File[]) {
    for (const f of Array.from(files)) {
      if (f.size > MAX_FILE_BYTES) {
        alert(`"${f.name}" supera i 25 MB e non puo' essere allegato.`);
        continue;
      }
      if (!selectedFiles.some((s) => s.name === f.name && s.size === f.size)) selectedFiles.push(f);
    }
    renderFileList();
  }

  fileInput.addEventListener('change', () => { if (fileInput.files) { addFiles(fileInput.files); fileInput.value = ''; } });

  // Drag & drop sull'area upload
  const dropZone = document.querySelector<HTMLElement>('.st__upload-drop')!;
  ['dragover', 'dragenter'].forEach((ev) => dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add('st__upload-drop--over'); }));
  ['dragleave', 'drop'].forEach((ev) => dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.remove('st__upload-drop--over'); }));
  dropZone.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer;
    if (dt?.files?.length) addFiles(dt.files);
  });

  // === Submit form: prima i documenti su Blob, poi la pratica ===
  const form = document.getElementById('pratica-form') as HTMLFormElement;
  // Cellulare, email e IBAN del cliente: obbligatori e controllati prima dell'invio
  const datiCliente = initDatiCliente(form);
  const feedback = document.getElementById('form-feedback')!;
  const submitBtn = form.querySelector<HTMLButtonElement>('.st__submit')!;

  function resetSubmitBtn() {
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<span class="material-icons-outlined">send</span> Invia pratica';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    feedback.hidden = true;
    feedback.classList.remove('st__feedback--ok', 'st__feedback--err');

    datiCliente.verifica();
    if (!form.reportValidity()) return;
    if (!accesso) { sessioneScaduta(); return; }

    submitBtn.disabled = true;

    // 1. Upload documenti direttamente su Blob (bypassa il limite 4,5 MB delle serverless)
    const documenti: { nome: string; pathname: string; size: number }[] = [];
    const batch = `${Date.now().toString(36)}`;
    try {
      for (let i = 0; i < selectedFiles.length; i++) {
        const f = selectedFiles[i];
        submitBtn.textContent = `Carico documento ${i + 1}/${selectedFiles.length}...`;
        const safeName = f.name.replace(/[^\w.\- ]/g, '_');
        // Una cartella per persona: all'invio il server accetta solo documenti di quella
        const result = await upload(`pratiche/${PARTNER}/docs/${accesso.utente.id}/${batch}/${safeName}`, f, {
          access: 'private',
          handleUploadUrl: '/api/portale-upload',
          clientPayload: JSON.stringify({ partner: PARTNER }),
        });
        documenti.push({ nome: f.name, pathname: result.pathname, size: f.size });
      }
    } catch (err) {
      feedback.textContent = 'Caricamento documenti non riuscito. Riprova, oppure invia la pratica senza allegati e mandiamo i documenti via email.';
      feedback.classList.add('st__feedback--err');
      feedback.hidden = false;
      resetSubmitBtn();
      return;
    }

    // 2. Invio pratica con l'elenco dei documenti caricati
    submitBtn.textContent = 'Invio pratica...';
    try {
      const fd = new FormData(form);
      fd.set('documenti', JSON.stringify(documenti));
      const res = await fetch('/api/submit-stilo', { method: 'POST', body: fd, credentials: 'same-origin' });
      if (res.status === 401) {
        feedback.textContent = 'La sessione è scaduta. Rientra con la tua password e premi di nuovo Invia: i dati del modulo restano.';
        feedback.classList.add('st__feedback--err');
        feedback.hidden = false;
        resetSubmitBtn();
        sessioneScaduta();
        return;
      }
      const json = await res.json();
      if (res.ok && json.ok) {
        feedback.textContent = `Pratica ${json.id ?? ''} ricevuta${documenti.length ? ` con ${documenti.length} documenti` : ''}. Ti richiamiamo al numero indicato; segui lo stato nella lista qui sotto.`;
        feedback.classList.add('st__feedback--ok');
        feedback.hidden = false;
        form.reset();
        selectedFiles = [];
        renderFileList();
        updateChecklist();
        void loadRichieste();
        submitBtn.innerHTML = '<span class="material-icons-outlined">check</span> Inviata';
        setTimeout(resetSubmitBtn, 3000);
      } else if (json?.messaggio) {
        // Il server ha rifiutato un dato del cliente: il motivo si mostra com'e'
        feedback.textContent = json.messaggio;
        feedback.classList.add('st__feedback--err');
        feedback.hidden = false;
        resetSubmitBtn();
      } else {
        throw new Error('server_error');
      }
    } catch (err) {
      feedback.textContent = 'Invio non riuscito. Riprova tra qualche secondo o chiama il 393 995 7840.';
      feedback.classList.add('st__feedback--err');
      feedback.hidden = false;
      resetSubmitBtn();
    }
  });

  // === Lista richieste ===
  const richiesteWrap = document.getElementById('richieste-wrap')!;
  const richiesteInfo = document.getElementById('richieste-info')!;
  const refreshBtn = document.getElementById('refresh-richieste') as HTMLButtonElement;
  const STATI = ['Ricevuta', 'In lavorazione', 'In delibera', 'Approvata', 'Declinata'];
  const STATO_CLASS: Record<string, string> = {
    'Ricevuta': 'st__stato--ricevuta',
    'In lavorazione': 'st__stato--lavorazione',
    'In delibera': 'st__stato--delibera',
    'Approvata': 'st__stato--approvata',
    'Declinata': 'st__stato--declinata',
  };

  const eurFmt = (v: string) => {
    const n = parseFloat(v);
    return isNaN(n) ? '-' : n.toLocaleString('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
  };
  const dataFmt = (iso: string) => {
    const d = new Date(iso);
    return isNaN(d.getTime()) ? '-' : d.toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: 'numeric' });
  };

  // Download di un documento dallo store privato: fetch autenticata + objectURL
  async function downloadDoc(pathname: string, nome: string) {
    if (!accesso) return;
    try {
      const res = await fetch(`${URL_PRATICHE}&doc=${encodeURIComponent(pathname)}`, { credentials: 'same-origin' });
      if (res.status === 401) { sessioneScaduta(); return; }
      if (!res.ok) throw new Error('download_failed');
      const blob = await res.blob();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = nome;
      a.click();
      URL.revokeObjectURL(a.href);
    } catch {
      alert('Download non riuscito. Riprova.');
    }
  }

  async function aggiornaStato(id: string, stato: string, select: HTMLSelectElement) {
    if (accesso?.ruolo !== 'admin') return;
    select.disabled = true;
    try {
      const { res, corpo } = await apiJson('/api/portale-pratiche', {
        method: 'POST',
        body: JSON.stringify({ id, stato, partner: PARTNER }),
      });
      if (!res.ok || !corpo?.ok) throw new Error('update_failed');
      select.className = `st__stato-select ${STATO_CLASS[stato] ?? ''}`;
    } catch {
      alert('Aggiornamento stato non riuscito. Riprova.');
      void loadRichieste();
    }
    select.disabled = false;
  }

  async function loadRichieste() {
    if (!accesso) return;
    richiesteInfo.textContent = '';
    try {
      const { res, corpo } = await apiJson(URL_PRATICHE);
      if (res.status === 401) { sessioneScaduta(); return; }
      if (!res.ok || !corpo?.ok) throw new Error(corpo?.error || 'list_failed');
      renderRichieste(corpo.pratiche ?? []);
    } catch (err) {
      richiesteWrap.innerHTML = '<p class="st__richieste-empty">Impossibile caricare le richieste in questo momento. Premi Aggiorna per riprovare.</p>';
    }
  }

  function renderRichieste(pratiche: any[]) {
    if (!pratiche.length) {
      richiesteInfo.textContent = '';
      richiesteWrap.innerHTML = accesso?.vedeTutto
        ? '<p class="st__richieste-empty">Nessuna richiesta inviata finora. La prima pratica caricata comparirà qui.</p>'
        : '<p class="st__richieste-empty">Non hai ancora caricato pratiche. La prima che carichi comparirà qui.</p>';
      return;
    }
    richiesteInfo.textContent = `${pratiche.length} richieste`;

    const isAdmin = accesso?.ruolo === 'admin';
    // Chi vede tutta STILO vede anche chi ha caricato cosa; l'agente vede solo le sue
    const conAutore = Boolean(accesso?.vedeTutto);
    const table = document.createElement('table');
    table.className = 'st__table st__table--richieste';
    table.innerHTML = `
      <thead>
        <tr><th>Data</th><th>Pratica</th>${conAutore ? '<th>Caricata da</th>' : ''}<th>Cliente</th><th>Bene</th><th>Importo</th><th>Documenti</th><th>Stato</th></tr>
      </thead>`;
    const tbody = document.createElement('tbody');

    for (const p of pratiche) {
      const tr = document.createElement('tr');

      const docsCell = document.createElement('td');
      const docs = Array.isArray(p.documenti) ? p.documenti : [];
      if (!docs.length) {
        docsCell.textContent = '—';
      } else {
        docs.forEach((d: any) => {
          const a = document.createElement('a');
          a.href = '#';
          a.className = 'st__doc-link';
          a.textContent = d.nome;
          a.addEventListener('click', (e) => { e.preventDefault(); void downloadDoc(d.pathname, d.nome); });
          docsCell.appendChild(a);
        });
      }

      const statoCell = document.createElement('td');
      const stato = p.stato ?? 'Ricevuta';
      if (isAdmin) {
        const sel = document.createElement('select');
        sel.className = `st__stato-select ${STATO_CLASS[stato] ?? ''}`;
        STATI.forEach((s) => {
          const opt = document.createElement('option');
          opt.value = s; opt.textContent = s; opt.selected = s === stato;
          sel.appendChild(opt);
        });
        sel.addEventListener('change', () => void aggiornaStato(p.id, sel.value, sel));
        statoCell.appendChild(sel);
      } else {
        const badge = document.createElement('span');
        badge.className = `st__stato ${STATO_CLASS[stato] ?? ''}`;
        badge.textContent = stato;
        statoCell.appendChild(badge);
      }

      const cells = [
        dataFmt(p.creato),
        p.id ?? '-',
        // Le pratiche caricate prima degli accessi personali non hanno autore
        ...(conAutore ? [p.autore ? (p.autore.nome || p.autore.email) : '—'] : []),
        p.cliente?.ragione_sociale ?? '-',
        `${p.bene?.tipologia ?? '-'} — ${p.bene?.descrizione ?? ''}`.slice(0, 60),
        `${eurFmt(p.bene?.importo ?? '')} / ${p.bene?.durata ?? '-'} mesi`,
      ];
      cells.forEach((c) => {
        const td = document.createElement('td');
        td.textContent = String(c);
        tr.appendChild(td);
      });
      tr.append(docsCell, statoCell);
      tbody.appendChild(tr);
    }

    table.appendChild(tbody);
    richiesteWrap.innerHTML = '';
    richiesteWrap.appendChild(table);
  }

  refreshBtn.addEventListener('click', () => void loadRichieste());

  // Ultima cosa: il gate. Se la sessione c'e' gia', entra senza chiedere niente.
  void avviaGate(entra, { percorso: PERCORSO, urlSessione: URL_PRATICHE });
</script>

