---
import Icon from '../../components/Icon.astro';
/**
 * Simulatore Noleggio Operativo — /tools/simulatore-noleggio-operativo
 * Pagina completa: hero, simulatore interattivo, sezione SEO, form consulenza.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import SimulatoreNoleggio from '../../components/tools/SimulatoreNoleggio.tsx';
import VerificaSimulatore from '../../components/tools/VerificaSimulatore.tsx';

const pageUrl = 'https://www.mediocreditofacile.it/tools/simulatore-noleggio-operativo';

// FAQ: fonte unica per la sezione visibile e per lo schema FAQPage.
// Domande costruite sulle ricerche reali (calcolo rata, beni strumentali,
// riscatto, deducibilità, confronto col leasing). Nessuna promessa su tassi
// o approvazioni: vincolo OAM.
const faqs = [
  {
    q: 'Come si calcola il canone del noleggio operativo?',
    a: "Il canone si ottiene moltiplicando il valore del bene per un coefficiente che dipende dalla durata del contratto e dalla fascia di importo: beni di valore più alto hanno coefficienti più bassi. Il simulatore applica i coefficienti ufficiali Grenke e restituisce un canone mensile indicativo. La cifra definitiva viene assegnata in base alla valutazione del merito creditizio dell'azienda.",
  },
  {
    q: 'Si può fare il noleggio operativo di beni strumentali?',
    a: 'Sì. Macchinari, attrezzature, mezzi, hardware e tecnologia a uso aziendale rientrano nel noleggio operativo di beni strumentali. L\'importo parte da poche migliaia di euro; sopra certe soglie cambiano i coefficienti e la documentazione richiesta. Il simulatore lavora su un\'ampia gamma di importi.',
  },
  {
    q: 'Il noleggio operativo prevede il riscatto del bene?',
    a: 'Dipende dal contratto. A fine durata puoi riscattare il bene a un valore concordato, restituirlo o rinnovare. Esistono formule di noleggio operativo con riscatto: nel simulatore vedi come cambia il canone a seconda dell\'opzione.',
  },
  {
    q: 'Il canone del noleggio operativo è deducibile?',
    a: 'Sì, il canone è un costo d\'esercizio interamente deducibile dal reddito d\'impresa per la durata del contratto, e l\'IVA segue le regole ordinarie di detrazione. Per il trattamento del tuo caso specifico conferma sempre con il tuo commercialista.',
  },
  {
    q: 'Che differenza c\'è tra noleggio operativo e leasing?',
    a: 'Nel leasing finanziario il bene entra nel tuo attivo e di norma c\'è un riscatto finale. Nel noleggio operativo paghi solo l\'uso del bene: il canone è interamente deducibile, non immobilizzi capitale e il rischio di obsolescenza resta al locatore. Per macchinari e tecnologia che invecchiano in fretta spesso conviene il noleggio.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Simulatore Noleggio Operativo',
  url: pageUrl,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  provider: {
    '@type': 'Organization',
    name: 'Mediocredito Facile',
    url: 'https://www.mediocreditofacile.it',
  },
};
---
<ToolLayout
  title="Simulatore Noleggio Operativo — Calcola il Canone | Mediocredito Facile"
  description="Calcola subito il canone mensile del noleggio operativo. Inserisci il valore del bene, scegli la durata e scopri quanto paghi al mese. Gratis, senza registrazione."
  breadcrumbs={[{ name: 'Simulatore Noleggio Operativo', href: '/tools/simulatore-noleggio-operativo' }]}
>
  <!-- Hero -->
  <section class="tool-hero">
    <div class="tool-hero__inner">
      <h1 class="tool-hero__title">Simulatore Noleggio Operativo</h1>
      <p class="tool-hero__sub">
        Calcola il canone mensile, il valore di riscatto e confronta con l'acquisto diretto.
        Coefficienti Grenke reali, risultato immediato.
      </p>
    </div>
  </section>

  <!-- Tab di navigazione tra i due simulatori -->
  <nav class="tool-tabs" aria-label="Modalità simulatore">
    <div class="tool-tabs__inner">
      <span class="tool-tabs__tab tool-tabs__tab--active">
        <Icon name="calculate" class="tool-tabs__icon" />
        Hai l'importo? Calcola la rata
      </span>
      <a href="/tools/simulatore-da-rata" class="tool-tabs__tab">
        <Icon name="swap_vert" class="tool-tabs__icon" />
        Hai la rata? Calcola l'importo
      </a>
    </div>
  </nav>

  <!-- Simulatore interattivo (Preact island) -->
  <section class="tool-simulator">
    <div class="tool-simulator__inner">
      <SimulatoreNoleggio client:load />
    </div>
  </section>

  <!-- Verifica del cliente: due moduli, esito su /grazie (vedi VerificaSimulatore.tsx) -->
  <section class="tool-form" id="contatti">
    <div class="tool-form__inner">
      <h2 class="tool-form__heading">Si può fare a noleggio?</h2>
      <p class="tool-form__sub">
        Lascia la partita IVA: la verifico nel registro imprese e vedi subito come si presenta la pratica.
        Ti richiamo entro 24 ore lavorative con il preventivo.
      </p>
      <VerificaSimulatore client:visible />
    </div>
  </section>

  <!-- Sezione SEO: Come funziona il noleggio operativo -->
  <section class="tool-seo">
    <div class="tool-seo__inner">
      <h2 class="tool-seo__heading">Come funziona il noleggio operativo</h2>

      <div class="tool-seo__grid">
        <div class="tool-seo__block">
          <Icon name="description" class="tool-seo__icon" />
          <h3 class="tool-seo__subtitle">Cos'è il noleggio operativo</h3>
          <p>
            Il noleggio operativo è un contratto con cui un'azienda utilizza un bene strumentale
            pagando un canone mensile fisso per tutta la durata. A fine contratto può riscattare
            il bene, restituirlo o rinnovare il contratto. Il canone è interamente deducibile
            dal reddito d'impresa.
          </p>
        </div>

        <div class="tool-seo__block">
          <Icon name="calculate" class="tool-seo__icon" />
          <h3 class="tool-seo__subtitle">Come si calcola il canone</h3>
          <p>
            Il canone dipende dal valore del bene, dalla durata del contratto e dal coefficiente
            applicato dalla società di locazione. I coefficienti variano in base alla fascia di
            importo: beni di valore maggiore beneficiano di coefficienti più bassi. Il simulatore
            usa i coefficienti ufficiali Grenke.
          </p>
        </div>

        <div class="tool-seo__block">
          <Icon name="compare_arrows" class="tool-seo__icon" />
          <h3 class="tool-seo__subtitle">Noleggio operativo vs acquisto diretto</h3>
          <p>
            Con l'acquisto diretto l'azienda immobilizza capitale. Con il noleggio operativo
            mantiene liquidità, ottiene la piena deducibilità del canone e trasferisce il rischio
            di obsolescenza al locatore. Per molte PMI è lo strumento più efficiente per dotarsi
            di macchinari e tecnologia. Scopri come scegliere la
            <a href="/societa-di-noleggio-operativo">società di noleggio operativo</a> giusta.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-link verso il simulatore inverso -->
  <section class="tool-crosslink">
    <div class="tool-crosslink__inner">
      <Icon name="swap_vert" class="tool-crosslink__icon" />
      <div>
        <p><strong>Conosci il budget mensile ma non il valore del bene?</strong></p>
        <p>Usa il <a href="/tools/simulatore-da-rata">Simulatore da Rata</a> per scoprire l'importo massimo finanziabile.</p>
      </div>
    </div>
  </section>

  <!-- FAQ: intercetta le ricerche lunghe + alimenta lo schema FAQPage -->
  <section class="tool-seo tool-faq">
    <div class="tool-seo__inner">
      <h2 class="tool-seo__heading">Domande frequenti sul noleggio operativo</h2>
      <div class="tool-faq__list">
        {faqs.map((f) => (
          <details class="tool-faq__item">
            <summary class="tool-faq__q">{f.q}</summary>
            <p class="tool-faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Dati strutturati: FAQ + applicazione web (risultati arricchiti) -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

</ToolLayout>


<style>
  /* --- Hero --- */
  .tool-hero {
    padding: 3.5rem 1.5rem 2.5rem;
    text-align: center;
    background: var(--color-bg);
  }

  .tool-hero__inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .tool-hero__title {
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .tool-hero__sub {
    font-size: 1.05rem;
    color: var(--color-text-light);
    line-height: 1.65;
  }

  /* --- Tab navigazione --- */
  .tool-tabs {
    padding: 0 1.5rem;
    background: var(--color-bg);
  }

  .tool-tabs__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    gap: 0;
    border-bottom: 2px solid var(--color-border);
  }

  .tool-tabs__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-light);
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    transition: color 0.2s, border-color 0.2s;
    cursor: pointer;
    text-decoration: none;
  }

  .tool-tabs__tab:hover {
    color: var(--color-primary);
  }

  .tool-tabs__tab--active {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    cursor: default;
  }

  .tool-tabs__icon {
    font-size: 1.2rem;
  }

  /* --- Simulatore container --- */
  .tool-simulator {
    padding: 0 1.5rem 4rem;
  }

  .tool-simulator__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  /* --- Sezione SEO --- */
  .tool-seo {
    padding: 4.5rem 1.5rem;
    background: var(--color-bg-alt);
  }

  .tool-seo__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .tool-seo__heading {
    text-align: center;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }

  .tool-seo__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .tool-seo__block {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem 1.75rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .tool-seo__icon {
    font-size: 2rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
    display: block;
  }

  .tool-seo__subtitle {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .tool-seo__block p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text);
  }

  /* --- Form consulenza --- */
  .tool-form {
    padding: 4.5rem 1.5rem;
    background: var(--color-bg);
  }

  .tool-form__inner {
    max-width: 520px;
    margin: 0 auto;
  }

  .tool-form__heading {
    text-align: center;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
  }

  .tool-form__sub {
    text-align: center;
    color: var(--color-text-light);
    margin-bottom: 2.5rem;
    font-size: 1rem;
  }

  /* --- Cross-link banner --- */
  .tool-crosslink {
    padding: 2rem 1.5rem;
    background: var(--color-bg);
  }

  .tool-crosslink__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem 2rem;
  }

  .tool-crosslink__icon {
    font-size: 2rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .tool-crosslink__inner p {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
    margin: 0;
  }

  .tool-crosslink__inner a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
  }

  .tool-crosslink__inner a:hover {
    color: var(--color-primary);
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .tool-hero {
      padding: 2.5rem 1.25rem 2rem;
    }

    .tool-tabs {
      padding: 0 1.25rem;
    }

    .tool-tabs__tab {
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
      gap: 0.35rem;
    }

    .tool-tabs__icon {
      font-size: 1rem;
    }

    .tool-simulator {
      padding: 0 1.25rem 3rem;
    }

    .tool-seo {
      padding: 3rem 1.25rem;
    }

    .tool-seo__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .tool-crosslink {
      padding: 1.5rem 1.25rem;
    }

    .tool-crosslink__inner {
      padding: 1.25rem 1.5rem;
    }

    .tool-form {
      padding: 3rem 1.25rem;
    }
  }
</style>

<style>
  /* --- FAQ accordion --- */
  .tool-faq__list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tool-faq__item {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  .tool-faq__q {
    font-weight: 700;
    color: var(--color-heading);
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 1.75rem;
  }

  .tool-faq__q::-webkit-details-marker {
    display: none;
  }

  .tool-faq__q::after {
    content: '+';
    position: absolute;
    right: 0;
    top: -0.1rem;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-primary);
    transition: transform 0.2s;
  }

  .tool-faq__item[open] .tool-faq__q::after {
    content: '−';
  }

  .tool-faq__a {
    margin-top: 0.75rem;
    color: var(--color-text);
    line-height: 1.65;
  }
</style>
