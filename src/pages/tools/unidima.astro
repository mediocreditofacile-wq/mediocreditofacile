---
import Icon from '../../components/Icon.astro';
/**
 * Portale Partner UNIDIMA SRL — /tools/unidima
 * Stessa struttura del portale FULL SERVICE (stesso motore condiviso):
 * - login con email + password (account del referente Fabio Maresca)
 * - dashboard con card in stile ReteRent (Simulazioni / Preventivi / Richieste)
 * - simulatore su UNA sola tabella, Grenke Pioneer: essendo l'unico canale il
 *   menu prodotto non compare
 * - form di caricamento pratica con checklist documenti dinamica e upload allegati
 * Lead vanno a /api/submit-unidima (mail dettagliata + Zapier).
 *
 * Ratio interna (non esposta in pagina): UNIDIMA importa e vende ledwall, schermi
 * LED e display. Censimento su ReteRent/Grenke (portale Contacto) in corso,
 * tabella coefficienti Pioneer. Fino al perfezionamento del censimento le pratiche
 * arrivano a MCF che le carica sui portali. Attenzione in istruttoria: societa'
 * costituita a fine 2024, un solo esercizio operativo, merce che arriva dalla Cina
 * e Grenke paga il fornitore a collaudo avvenuto.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import SimulatorePortale from '../../components/tools/SimulatorePortale.tsx';
---
<ToolLayout
  title="Portale UNIDIMA — Simulazioni e Pratiche | Mediocredito Facile"
  description="Portale riservato UNIDIMA SRL: simulazione canoni di noleggio operativo su ledwall, schermi LED e display, caricamento pratiche cliente."
  noindex={true}
  breadcrumbs={[{ name: 'Portale UNIDIMA', href: '/tools/unidima' }]}
>
  <!-- Gate login -->
  <div id="gate" class="gate">
    <div class="gate__card">
      <div class="gate__logos">
        <img src="/images/logo-mediocreditofacile.webp" alt="Mediocredito Facile" class="gate__logo" />
        <span class="gate__x">&times;</span>
        <span class="gate__partner-name">UNIDIMA SRL</span>
      </div>
      <div class="gate__divider"></div>
      <p class="gate__label">Portale Riservato Partner</p>
      <p class="gate__desc">Simulazione canoni di noleggio operativo su ledwall, schermi LED e display, e caricamento pratiche cliente.</p>
      <div class="gate__form">
        <input type="email" id="gate-user" class="gate__input" placeholder="Email" autocomplete="username" />
        <input type="password" id="gate-pwd" class="gate__input" placeholder="Password" autocomplete="current-password" />
        <button id="gate-btn" class="gate__btn">
          <Icon name="lock_open" />
          Accedi
        </button>
      </div>
      <p id="gate-error" class="gate__error" hidden>Email o password non corretti</p>
    </div>
  </div>

  <!-- Portale (nascosto fino ad autenticazione) -->
  <div id="tool" class="ud" style="display:none !important;">
    <!-- Header co-branded -->
    <div class="ud__header">
      <div class="ud__header-brand">
        <img src="/images/logo-mediocreditofacile.webp" alt="Mediocredito Facile" class="ud__logo" />
        <div class="ud__header-sep"></div>
        <div class="ud__partner-badge">
          <Icon name="ict-digital" class="ud__partner-icon" />
          <span class="ud__partner-label">UNIDIMA SRL</span>
        </div>
      </div>
      <button id="logout-btn" class="ud__logout">
        <Icon name="logout" />
        Esci
      </button>
    </div>

    <!-- Riga codice partner, come il "Codice Convenzione" ReteRent -->
    <p class="ud__conv">Codice partner <strong>UNIDIMA</strong></p>

    <!-- Dashboard card -->
    <h1 class="ud__dash-title">Gestione offerte di noleggio</h1>
    <div class="ud__cards">
      <a href="#simulatore" class="ud__card">
        <div class="ud__card-head"><Icon name="calculate" /> Simulazioni</div>
        <p class="ud__card-desc">Calcola i canoni di noleggio a partire dal prezzo di vendita, oppure parti dal canone per ottenere il prezzo.</p>
        <span class="ud__card-link">Nuova simulazione &raquo;</span>
      </a>
      <a href="#simulatore" class="ud__card">
        <div class="ud__card-head"><Icon name="description" /> Preventivi</div>
        <p class="ud__card-desc">Stampa la simulazione in versione pulita, pronta da consegnare o inviare al cliente.</p>
        <span class="ud__card-link">Stampa simulazione &raquo;</span>
      </a>
      <div class="ud__card">
        <div class="ud__card-head"><Icon name="send" /> Richieste</div>
        <p class="ud__card-desc">Trasmetti la pratica con i documenti del cliente allegati e controlla lo stato di quelle già inviate.</p>
        <span>
          <a class="ud__card-link" href="#pratica">Carica una pratica &raquo;</a><br />
          <a class="ud__card-link" href="#richieste">Lista richieste &raquo;</a>
        </span>
      </div>
      <a href="#documenti" class="ud__card">
        <div class="ud__card-head"><Icon name="checklist" /> Documenti</div>
        <p class="ud__card-desc">La checklist dei documenti si aggiorna da sola in base a importo e forma giuridica del cliente.</p>
        <span class="ud__card-link">Vedi checklist &raquo;</span>
      </a>
    </div>

    <!-- 1. Simulatore -->
    <section id="simulatore" class="ud__section">
      <header class="ud__section-head">
        <span class="ud__section-num">1</span>
        <div>
          <h2 class="ud__section-title">Simula i canoni</h2>
          <p class="ud__section-sub">
            Noleggio operativo su ledwall, schermi LED e display, durate da 24 a 60 mesi. Parti dal prezzo
            di vendita per vedere il canone su tutte le durate, oppure dal canone che il cliente ha in testa
            per ricavare il prezzo. In entrambe le tabelle l'assicurazione all risk non è compresa nel
            canone e si aggiunge a parte. L'importo definitivo viene confermato dopo la delibera.
          </p>
        </div>
      </header>
      <SimulatorePortale
        client:load
        tabelle={['pagarent', 'pioneer']}
        partner="UNIDIMA SRL"
        etichetteBene={{
          pagarent: 'Ledwall / schermo LED',
          pioneer: 'Ledwall / schermo LED',
        }}
      />
    </section>

    <!-- 2. Carica pratica -->
    <section id="pratica" class="ud__section">
      <header class="ud__section-head">
        <span class="ud__section-num">2</span>
        <div>
          <h2 class="ud__section-title">Carica una pratica</h2>
          <p class="ud__section-sub">
            Compila i dati del cliente finale e del bene. La checklist documenti qui sotto si aggiorna mentre scrivi:
            chiede solo quello che serve per quell'importo e quella forma giuridica.
          </p>
        </div>
      </header>

      <form id="pratica-form" class="ud__form" novalidate>
        <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true" />

        <div class="ud__form-block">
          <h3 class="ud__form-block-title">Cliente finale</h3>
          <div class="ud__grid">
            <label class="ud__field ud__field--full">
              <span class="ud__field-label">Ragione sociale / Nominativo *</span>
              <input type="text" name="ragione_sociale" required placeholder="Es. Studio Rossi SRL" />
            </label>

            <label class="ud__field">
              <span class="ud__field-label">Forma giuridica *</span>
              <select name="forma_giuridica" id="forma-giuridica" required>
                <option value="">Seleziona</option>
                <option value="Ditta Individuale">Ditta Individuale</option>
                <option value="SRL">SRL</option>
                <option value="SRLS">SRL Semplificata</option>
                <option value="SPA">SPA</option>
                <option value="SNC">SNC</option>
                <option value="SAS">SAS</option>
                <option value="Lavoratore Autonomo">Lavoratore Autonomo</option>
                <option value="Cooperativa">Cooperativa</option>
              </select>
            </label>

            <label class="ud__field">
              <span class="ud__field-label">Partita IVA / CF</span>
              <input type="text" name="piva" placeholder="11 cifre" inputmode="numeric" />
            </label>

            <label class="ud__field">
              <span class="ud__field-label">Referente</span>
              <input type="text" name="referente" placeholder="Nome e cognome" />
            </label>

            <label class="ud__field">
              <span class="ud__field-label">Telefono *</span>
              <input type="tel" name="telefono" required placeholder="+39 333 1234567" />
            </label>

            <label class="ud__field ud__field--full">
              <span class="ud__field-label">Email *</span>
              <input type="email" name="email" required placeholder="cliente@esempio.it" />
            </label>
          </div>
        </div>

        <div class="ud__form-block">
          <h3 class="ud__form-block-title">Beni da noleggiare</h3>
          <p class="ud__beni-hint">Aggiungi tutti i beni del contratto: il canone si calcola sul totale imponibile.</p>

          <div id="beni-rows" class="ud__beni">
            <div class="bene-row ud__bene-row">
              <label class="ud__field">
                <span class="ud__field-label">Tipologia</span>
                <select data-bene="tipologia">
                  <option value="Ledwall indoor" selected>Ledwall indoor</option>
                  <option value="Ledwall outdoor">Ledwall outdoor</option>
                  <option value="Monitor e display">Monitor e display professionali</option>
                  <option value="Totem e vetrine LED">Totem e vetrine LED</option>
                  <option value="Struttura e installazione">Struttura, staffe e installazione</option>
                  <option value="Player e software">Player, controller e software di gestione</option>
                  <option value="Altro">Altro bene strumentale</option>
                </select>
              </label>
              <label class="ud__field ud__field--grow">
                <span class="ud__field-label">Descrizione bene *</span>
                <input type="text" data-bene="descrizione" required placeholder="Es. Ledwall indoor P2.5 - 4x2 m con processore" />
              </label>
              <label class="ud__field ud__field--importo">
                <span class="ud__field-label">Importo (€) *</span>
                <input type="number" data-bene="importo" required min="0" step="100" placeholder="12000" />
              </label>
              <button type="button" class="ud__bene-remove" data-bene-remove aria-label="Rimuovi bene">&times;</button>
            </div>
          </div>

          <div class="ud__beni-bar">
            <button type="button" id="beni-add" class="ud__beni-add">
              <Icon name="add" /> Aggiungi bene
            </button>
            <div class="ud__beni-total-wrap">Totale imponibile <strong id="beni-total">0,00 €</strong></div>
          </div>

          <input type="hidden" name="beni" id="beni-json" />
          <input type="hidden" name="importo" id="importo" />

          <div class="ud__grid ud__grid--contratto">
            <label class="ud__field">
              <span class="ud__field-label">Durata noleggio (mesi)</span>
              <select name="durata">
                <option value="24">24 mesi</option>
                <option value="30">30 mesi</option>
                <option value="36">36 mesi</option>
                <option value="48">48 mesi</option>
                <option value="60" selected>60 mesi</option>
              </select>
            </label>

            <label class="ud__field">
              <span class="ud__field-label">Canone simulato (€/mese)</span>
              <input type="number" name="canone_simulato" min="0" step="1" placeholder="Dal simulatore qui sopra" />
            </label>

            <label class="ud__field ud__field--full">
              <span class="ud__field-label">Note (opzionale)</span>
              <textarea name="note" rows="3" placeholder="Contesto del cliente, urgenza, dettagli dell'installazione..."></textarea>
            </label>
          </div>
        </div>

        <!-- Checklist documenti dinamica -->
        <div id="documenti" class="ud__form-block">
          <h3 class="ud__form-block-title">Documenti da raccogliere</h3>

          <div id="checklist-banner" class="ud__banner ud__banner--base">
            <Icon name="info" class="ud__banner-icon" />
            <div>
              <strong id="banner-title">Documenti base</strong>
              <p id="banner-sub">Per importi fino a 10.000 € bastano i documenti standard. Sopra i 10.000 € la società di noleggio chiede anche i reddituali.</p>
            </div>
          </div>

          <table class="ud__table">
            <thead>
              <tr>
                <th>Documento</th>
                <th class="ud__th-when">Quando serve</th>
              </tr>
            </thead>
            <tbody id="checklist-body">
              <tr><td>Visura camerale (o visura ditta individuale)</td><td>Sempre</td></tr>
              <tr><td>Carta d'identita' del legale rappresentante / titolare</td><td>Sempre</td></tr>
              <tr><td>Tessera sanitaria / codice fiscale</td><td>Sempre</td></tr>
              <tr><td>Coordinate IBAN aziendali</td><td>Sempre</td></tr>
              <tr><td>Email aziendale</td><td>Sempre</td></tr>
              <tr><td>Cellulare del referente</td><td>Sempre</td></tr>
              <tr><td>Offerta / preventivo al cliente finale</td><td>Sempre</td></tr>
              <tr class="ud__row-extra" data-extra="di" hidden>
                <td>Ultime 2 dichiarazioni dei redditi (Modello Unico)</td>
                <td>Solo Ditta Individuale, importo &gt; 10.000 €</td>
              </tr>
              <tr class="ud__row-extra" data-extra="di" hidden>
                <td>Situazione contabile aggiornata 2025</td>
                <td>Solo Ditta Individuale, importo &gt; 10.000 €</td>
              </tr>
              <tr class="ud__row-extra" data-extra="srl" hidden>
                <td>Ultimi 2 bilanci depositati</td>
                <td>Solo societa' di capitali, importo &gt; 10.000 €</td>
              </tr>
              <tr class="ud__row-extra" data-extra="srl" hidden>
                <td>Bilancio definitivo 2025 (anche pre-deposito)</td>
                <td>Solo societa' di capitali, importo &gt; 10.000 €</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Upload documenti -->
        <div class="ud__form-block">
          <h3 class="ud__form-block-title">Allega i documenti</h3>
          <p class="ud__upload-hint">
            PDF, immagini, visure firmate (.p7m), Word ed Excel — massimo 25 MB a file.
            Puoi inviare la pratica anche senza documenti e integrarli in un secondo momento.
          </p>
          <label class="ud__upload-drop" for="file-input">
            <Icon name="upload_file" class="ud__upload-icon" />
            <span><strong>Scegli i file da allegare</strong> oppure trascinali qui</span>
            <input type="file" id="file-input" multiple accept=".pdf,.jpg,.jpeg,.png,.heic,.p7m,.doc,.docx,.xls,.xlsx" hidden />
          </label>
          <ul id="file-list" class="ud__file-list"></ul>
        </div>

        <div class="ud__submit-row">
          <button type="submit" class="ud__submit">
            <Icon name="send" />
            Invia pratica
          </button>
          <p class="ud__submit-hint">
            Riceviamo pratica e documenti in tempo reale. Ti richiamiamo al telefono indicato per la conferma e vedi l'avanzamento nella lista richieste qui sotto.
          </p>
        </div>

        <div id="form-feedback" class="ud__feedback" hidden></div>
      </form>
    </section>

    <!-- 3. Le tue richieste -->
    <section id="richieste" class="ud__section">
      <header class="ud__section-head">
        <span class="ud__section-num">3</span>
        <div>
          <h2 class="ud__section-title">Le tue richieste</h2>
          <p class="ud__section-sub">
            Tutte le pratiche trasmesse, con documenti e stato di avanzamento. Lo stato viene aggiornato da Mediocredito Facile man mano che la pratica avanza.
          </p>
        </div>
      </header>

      <div class="ud__richieste-bar">
        <button type="button" id="refresh-richieste" class="ud__refresh">
          <Icon name="refresh" />
          Aggiorna
        </button>
        <span id="richieste-info" class="ud__richieste-info"></span>
      </div>

      <div id="richieste-wrap" class="ud__richieste-wrap">
        <p class="ud__richieste-empty">Caricamento in corso...</p>
      </div>
    </section>
  </div>
</ToolLayout>

<script>
  import { upload } from '@vercel/blob/client';
  import { initBeniRows } from '../../scripts/beni-rows';

  // Due account sul gate:
  //  - partner: Fabio Maresca (UNIDIMA) — credenziali fisse
  //  - admin: Alberto — email MCF + chiave admin, verificata SERVER-SIDE
  //    contro la env var EXPO_PORTAL_ADMIN_KEY (la chiave non sta nel sorgente)
  const PARTNER = 'unidima';
  const USER_EMAIL = 'info@unidima.it';
  const PASSWORD = 'unidima';
  const ADMIN_EMAIL = 'mediocreditofacile@gmail.com';
  const KEY = 'mcf_unidima_auth';

  type Session = { role: 'partner' | 'admin'; key: string };
  let session: Session | null = null;

  const gate = document.getElementById('gate')!;
  const tool = document.getElementById('tool')!;
  const gateUser = document.getElementById('gate-user') as HTMLInputElement;
  const gatePwd = document.getElementById('gate-pwd') as HTMLInputElement;
  const gateBtn = document.getElementById('gate-btn') as HTMLButtonElement;
  const gateError = document.getElementById('gate-error')!;
  const logoutBtn = document.getElementById('logout-btn')!;

  function showTool() {
    gate.style.display = 'none';
    tool.style.cssText = '';
    tool.classList.toggle('ud--admin', session?.role === 'admin');
    // Deferita: al primo accesso lo script sta ancora valutando le const
    // della sezione richieste (TDZ), quindi si aspetta il tick successivo
    setTimeout(() => void loadRichieste(), 0);
  }
  function showGate() { gate.style.display = ''; tool.style.cssText = 'display:none !important;'; }

  function loadSession(): Session | null {
    const raw = localStorage.getItem(KEY);
    if (!raw) return null;
    if (raw === 'ok') return { role: 'partner', key: PASSWORD }; // retrocompatibilita'
    try {
      const s = JSON.parse(raw);
      if (s && (s.role === 'partner' || s.role === 'admin') && typeof s.key === 'string') return s;
    } catch { /* sessione corrotta: si rifa' il login */ }
    return null;
  }

  session = loadSession();
  if (session) showTool();

  function gateFail(msg: string, userBad: boolean, pwdBad: boolean) {
    gateError.textContent = msg;
    gateError.hidden = false;
    gateUser.classList.toggle('gate__input--error', userBad);
    gatePwd.classList.toggle('gate__input--error', pwdBad);
  }

  gateBtn.addEventListener('click', async () => {
    const email = gateUser.value.trim().toLowerCase();
    const pwd = gatePwd.value.trim();

    if (email === USER_EMAIL && pwd.toLowerCase() === PASSWORD) {
      session = { role: 'partner', key: PASSWORD };
    } else if (email === ADMIN_EMAIL && pwd) {
      // Verifica della chiave admin lato server
      gateBtn.disabled = true;
      gateBtn.textContent = 'Verifica...';
      try {
        const res = await fetch(`/api/pratiche-expo?partner=${PARTNER}`, { headers: { Authorization: `Bearer ${pwd}` } });
        const json = await res.json();
        if (res.ok && json.ok && json.ruolo === 'admin') {
          session = { role: 'admin', key: pwd };
        } else {
          gateFail('Chiave admin non valida', false, true);
        }
      } catch {
        gateFail('Verifica non riuscita, riprova', false, false);
      }
      gateBtn.disabled = false;
      gateBtn.innerHTML = '<span class="material-icons-outlined">lock_open</span> Accedi';
    } else {
      gateFail('Email o password non corretti', email !== USER_EMAIL && email !== ADMIN_EMAIL, true);
    }

    if (session) {
      localStorage.setItem(KEY, JSON.stringify(session));
      gateError.hidden = true;
      gateUser.classList.remove('gate__input--error');
      gatePwd.classList.remove('gate__input--error');
      showTool();
    }
  });
  gateUser.addEventListener('keydown', (e) => { if (e.key === 'Enter') gateBtn.click(); });
  gatePwd.addEventListener('keydown', (e) => { if (e.key === 'Enter') gateBtn.click(); });
  logoutBtn.addEventListener('click', () => {
    localStorage.removeItem(KEY); session = null; showGate();
    gateUser.value = ''; gatePwd.value = ''; gateError.hidden = true;
  });

  // === Checklist dinamica (stessa logica dell'area Edilizia GIERRE) ===
  const formaGiuridica = document.getElementById('forma-giuridica') as HTMLSelectElement;
  const importoInput = document.getElementById('importo') as HTMLInputElement;
  const banner = document.getElementById('checklist-banner')!;
  const bannerTitle = document.getElementById('banner-title')!;
  const bannerSub = document.getElementById('banner-sub')!;
  const extraRows = document.querySelectorAll<HTMLTableRowElement>('.ud__row-extra');

  const FORMA_DI = ['Ditta Individuale', 'Lavoratore Autonomo'];

  function updateChecklist() {
    const importo = parseFloat(importoInput.value) || 0;
    const fg = formaGiuridica.value;
    const sopraSoglia = importo > 10000;
    const isDi = FORMA_DI.includes(fg);
    const isSocieta = fg && !isDi;

    extraRows.forEach((row) => {
      const tag = row.dataset.extra;
      let show = false;
      if (sopraSoglia) {
        if (tag === 'di' && isDi) show = true;
        if (tag === 'srl' && isSocieta) show = true;
      }
      row.hidden = !show;
    });

    banner.classList.remove('ud__banner--base', 'ud__banner--full');
    if (sopraSoglia && fg) {
      banner.classList.add('ud__banner--full');
      bannerTitle.textContent = `Documenti completi (${isDi ? 'Ditta Individuale' : 'Societa\' di capitali'})`;
      bannerSub.textContent = isDi
        ? 'Importo sopra 10.000 €: oltre ai documenti base servono le ultime 2 dichiarazioni dei redditi e la situazione contabile 2025.'
        : 'Importo sopra 10.000 €: oltre ai documenti base servono gli ultimi 2 bilanci depositati e il bilancio definitivo 2025.';
    } else if (sopraSoglia && !fg) {
      banner.classList.add('ud__banner--base');
      bannerTitle.textContent = 'Seleziona la forma giuridica';
      bannerSub.textContent = 'Sopra 10.000 € la documentazione reddituale cambia tra Ditta Individuale e Societa\' di capitali. Scegli la forma giuridica per la lista esatta.';
    } else {
      banner.classList.add('ud__banner--base');
      bannerTitle.textContent = 'Documenti base';
      bannerSub.textContent = 'Per importi fino a 10.000 € bastano i documenti standard. Sopra i 10.000 € la società di noleggio chiede anche i reddituali.';
    }
  }

  formaGiuridica.addEventListener('change', updateChecklist);
  importoInput.addEventListener('input', updateChecklist);

  // === Distinta beni (una pratica = un contratto con piu' beni) ===
  // Popola il campo importo (totale) e fa scattare la checklist qui sopra.
  initBeniRows();

  // === Gestione file selezionati ===
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileList = document.getElementById('file-list')!;
  const MAX_FILE_BYTES = 25 * 1024 * 1024;
  let selectedFiles: File[] = [];

  function fmtSize(n: number): string {
    return n > 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.round(n / 1024)} KB`;
  }

  function renderFileList() {
    fileList.innerHTML = '';
    selectedFiles.forEach((f, i) => {
      const li = document.createElement('li');
      li.className = 'ud__file-item';
      const name = document.createElement('span');
      name.className = 'ud__file-name';
      name.textContent = `${f.name} (${fmtSize(f.size)})`;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ud__file-remove';
      btn.textContent = 'Rimuovi';
      btn.addEventListener('click', () => { selectedFiles.splice(i, 1); renderFileList(); });
      li.append(name, btn);
      fileList.appendChild(li);
    });
  }

  function addFiles(files: FileList | File[]) {
    for (const f of Array.from(files)) {
      if (f.size > MAX_FILE_BYTES) {
        alert(`"${f.name}" supera i 25 MB e non puo' essere allegato.`);
        continue;
      }
      if (!selectedFiles.some((s) => s.name === f.name && s.size === f.size)) selectedFiles.push(f);
    }
    renderFileList();
  }

  fileInput.addEventListener('change', () => { if (fileInput.files) { addFiles(fileInput.files); fileInput.value = ''; } });

  // Drag & drop sull'area upload
  const dropZone = document.querySelector<HTMLElement>('.ud__upload-drop')!;
  ['dragover', 'dragenter'].forEach((ev) => dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add('ud__upload-drop--over'); }));
  ['dragleave', 'drop'].forEach((ev) => dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.remove('ud__upload-drop--over'); }));
  dropZone.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer;
    if (dt?.files?.length) addFiles(dt.files);
  });

  // === Submit form: prima i documenti su Blob, poi la pratica ===
  const form = document.getElementById('pratica-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback')!;
  const submitBtn = form.querySelector<HTMLButtonElement>('.ud__submit')!;

  function resetSubmitBtn() {
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<span class="material-icons-outlined">send</span> Invia pratica';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    feedback.hidden = true;
    feedback.classList.remove('ud__feedback--ok', 'ud__feedback--err');

    if (!form.reportValidity()) return;
    if (!session) { showGate(); return; }

    submitBtn.disabled = true;

    // 1. Upload documenti direttamente su Blob (bypassa il limite 4,5 MB delle serverless)
    const documenti: { nome: string; pathname: string; size: number }[] = [];
    const batch = `${Date.now().toString(36)}`;
    try {
      for (let i = 0; i < selectedFiles.length; i++) {
        const f = selectedFiles[i];
        submitBtn.textContent = `Carico documento ${i + 1}/${selectedFiles.length}...`;
        const safeName = f.name.replace(/[^\w.\- ]/g, '_');
        const result = await upload(`pratiche/${PARTNER}/docs/${batch}/${safeName}`, f, {
          access: 'private',
          handleUploadUrl: '/api/blob-upload',
          clientPayload: JSON.stringify({ auth: session.key, partner: PARTNER }),
        });
        documenti.push({ nome: f.name, pathname: result.pathname, size: f.size });
      }
    } catch (err) {
      feedback.textContent = 'Caricamento documenti non riuscito. Riprova, oppure invia la pratica senza allegati e mandiamo i documenti via email.';
      feedback.classList.add('ud__feedback--err');
      feedback.hidden = false;
      resetSubmitBtn();
      return;
    }

    // 2. Invio pratica con l'elenco dei documenti caricati
    submitBtn.textContent = 'Invio pratica...';
    try {
      const fd = new FormData(form);
      fd.set('documenti', JSON.stringify(documenti));
      const res = await fetch('/api/submit-unidima', { method: 'POST', body: fd });
      const json = await res.json();
      if (res.ok && json.ok) {
        feedback.textContent = `Pratica ${json.id ?? ''} ricevuta${documenti.length ? ` con ${documenti.length} documenti` : ''}. Ti richiamiamo al numero indicato; segui lo stato nella lista qui sotto.`;
        feedback.classList.add('ud__feedback--ok');
        feedback.hidden = false;
        form.reset();
        selectedFiles = [];
        renderFileList();
        updateChecklist();
        void loadRichieste();
        submitBtn.innerHTML = '<span class="material-icons-outlined">check</span> Inviata';
        setTimeout(resetSubmitBtn, 3000);
      } else {
        throw new Error('server_error');
      }
    } catch (err) {
      feedback.textContent = 'Invio non riuscito. Riprova tra qualche secondo o chiama il 393 995 7840.';
      feedback.classList.add('ud__feedback--err');
      feedback.hidden = false;
      resetSubmitBtn();
    }
  });

  // === Lista richieste ===
  const richiesteWrap = document.getElementById('richieste-wrap')!;
  const richiesteInfo = document.getElementById('richieste-info')!;
  const refreshBtn = document.getElementById('refresh-richieste') as HTMLButtonElement;
  const STATI = ['Ricevuta', 'In lavorazione', 'In delibera', 'Approvata', 'Declinata'];
  const STATO_CLASS: Record<string, string> = {
    'Ricevuta': 'ud__stato--ricevuta',
    'In lavorazione': 'ud__stato--lavorazione',
    'In delibera': 'ud__stato--delibera',
    'Approvata': 'ud__stato--approvata',
    'Declinata': 'ud__stato--declinata',
  };

  const eurFmt = (v: string) => {
    const n = parseFloat(v);
    return isNaN(n) ? '-' : n.toLocaleString('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
  };
  const dataFmt = (iso: string) => {
    const d = new Date(iso);
    return isNaN(d.getTime()) ? '-' : d.toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: 'numeric' });
  };

  // Download di un documento dallo store privato: fetch autenticata + objectURL
  async function downloadDoc(pathname: string, nome: string) {
    if (!session) return;
    try {
      const res = await fetch(`/api/pratica-doc?path=${encodeURIComponent(pathname)}`, {
        headers: { Authorization: `Bearer ${session.key}` },
      });
      if (!res.ok) throw new Error('download_failed');
      const blob = await res.blob();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = nome;
      a.click();
      URL.revokeObjectURL(a.href);
    } catch {
      alert('Download non riuscito. Riprova.');
    }
  }

  async function aggiornaStato(id: string, stato: string, select: HTMLSelectElement) {
    if (!session || session.role !== 'admin') return;
    select.disabled = true;
    try {
      const res = await fetch('/api/pratiche-expo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session.key}` },
        body: JSON.stringify({ id, stato, partner: PARTNER }),
      });
      const json = await res.json();
      if (!res.ok || !json.ok) throw new Error('update_failed');
      select.className = `ud__stato-select ${STATO_CLASS[stato] ?? ''}`;
    } catch {
      alert('Aggiornamento stato non riuscito. Riprova.');
      void loadRichieste();
    }
    select.disabled = false;
  }

  async function loadRichieste() {
    if (!session) return;
    richiesteInfo.textContent = '';
    try {
      const res = await fetch(`/api/pratiche-expo?partner=${PARTNER}`, { headers: { Authorization: `Bearer ${session.key}` } });
      const json = await res.json();
      if (res.status === 401) {
        // Sessione non piu' valida (es. chiave admin cambiata): si rifa' il login
        localStorage.removeItem(KEY); session = null; showGate();
        return;
      }
      if (!res.ok || !json.ok) throw new Error(json.error || 'list_failed');
      renderRichieste(json.pratiche ?? []);
    } catch (err) {
      richiesteWrap.innerHTML = '<p class="ud__richieste-empty">Impossibile caricare le richieste in questo momento. Premi Aggiorna per riprovare.</p>';
    }
  }

  function renderRichieste(pratiche: any[]) {
    if (!pratiche.length) {
      richiesteWrap.innerHTML = '<p class="ud__richieste-empty">Nessuna richiesta inviata finora. La prima pratica che carichi comparira\' qui.</p>';
      return;
    }
    richiesteInfo.textContent = `${pratiche.length} richieste`;

    const isAdmin = session?.role === 'admin';
    const table = document.createElement('table');
    table.className = 'ud__table ud__table--richieste';
    table.innerHTML = `
      <thead>
        <tr><th>Data</th><th>Pratica</th><th>Cliente</th><th>Bene</th><th>Importo</th><th>Documenti</th><th>Stato</th></tr>
      </thead>`;
    const tbody = document.createElement('tbody');

    for (const p of pratiche) {
      const tr = document.createElement('tr');

      const docsCell = document.createElement('td');
      const docs = Array.isArray(p.documenti) ? p.documenti : [];
      if (!docs.length) {
        docsCell.textContent = '—';
      } else {
        docs.forEach((d: any) => {
          const a = document.createElement('a');
          a.href = '#';
          a.className = 'ud__doc-link';
          a.textContent = d.nome;
          a.addEventListener('click', (e) => { e.preventDefault(); void downloadDoc(d.pathname, d.nome); });
          docsCell.appendChild(a);
        });
      }

      const statoCell = document.createElement('td');
      const stato = p.stato ?? 'Ricevuta';
      if (isAdmin) {
        const sel = document.createElement('select');
        sel.className = `ud__stato-select ${STATO_CLASS[stato] ?? ''}`;
        STATI.forEach((s) => {
          const opt = document.createElement('option');
          opt.value = s; opt.textContent = s; opt.selected = s === stato;
          sel.appendChild(opt);
        });
        sel.addEventListener('change', () => void aggiornaStato(p.id, sel.value, sel));
        statoCell.appendChild(sel);
      } else {
        const badge = document.createElement('span');
        badge.className = `ud__stato ${STATO_CLASS[stato] ?? ''}`;
        badge.textContent = stato;
        statoCell.appendChild(badge);
      }

      const cells = [
        dataFmt(p.creato),
        p.id ?? '-',
        p.cliente?.ragione_sociale ?? '-',
        `${p.bene?.tipologia ?? '-'} — ${p.bene?.descrizione ?? ''}`.slice(0, 60),
        `${eurFmt(p.bene?.importo ?? '')} / ${p.bene?.durata ?? '-'} mesi`,
      ];
      cells.forEach((c) => {
        const td = document.createElement('td');
        td.textContent = String(c);
        tr.appendChild(td);
      });
      tr.append(docsCell, statoCell);
      tbody.appendChild(tr);
    }

    table.appendChild(tbody);
    richiesteWrap.innerHTML = '';
    richiesteWrap.appendChild(table);
  }

  refreshBtn.addEventListener('click', () => void loadRichieste());
</script>

