---
import Icon from '../../components/Icon.astro';
/**
 * Simulatore Leasing — variante LO MARTIRE — /tools/simulatore-leasing-lomartire
 * Pagina protetta da password (`lorenzo`, localStorage key `mcf_lomartire_auth`, noindex).
 * Dedicato a Lorenzo Lo Martire, intestatario delle pratiche raccolte tramite questo flusso.
 *
 * Differenza con le altre varianti:
 *  - Provvigioni al MINIMO per ogni partner (prima condizione del listino)
 *  - Spese istruttoria mostrate = istruttoria partner + COMPENSO_LOMARTIRE_PERC × importo (sommate)
 *  - Per Alba in promo Easy Lease il markup sale a 1,20% (e l'istruttoria partner e' azzerata)
 *  - In pagina compaiono due righe separate "Spese istruttoria partner" + "Compenso intermediario"
 *  - Il PDF al cliente le accorpa in una voce unica "Spese istruttoria"
 *
 * Configurazione centralizzata in `src/data/leasing.ts`:
 *  - `COMPENSO_LOMARTIRE_PERC` (1,00%) e `COMPENSO_LOMARTIRE_ALBA_PROMO_PERC` (1,20%)
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import SimulatoreLeasing from '../../components/tools/SimulatoreLeasing.tsx';
---
<ToolLayout
  title="Simulatore Leasing — Lo Martire | Mediocredito Facile"
  description="Area riservata Lorenzo Lo Martire: simulatore leasing strumentale con provvigioni al minimo e compenso intermediario incluso."
  noindex={true}
  breadcrumbs={[{ name: 'Simulatore Lo Martire', href: '/tools/simulatore-leasing-lomartire' }]}
>
  <!-- Gate password -->
  <div id="gate" class="gate">
    <div class="gate__card">
      <div class="gate__logos">
        <img src="/images/logo-mediocreditofacile.webp" alt="Mediocredito Facile" class="gate__logo" />
      </div>
      <div class="gate__divider"></div>
      <p class="gate__label">Area Riservata</p>
      <h1 class="gate__title">Simulatore Leasing — Lo Martire</h1>
      <p class="gate__desc">Simulatore canone leasing strumentale dedicato a Lorenzo Lo Martire: provvigioni al minimo, compenso intermediario incluso nelle spese istruttoria, PDF brandizzato MCF.</p>
      <div class="gate__form">
        <input type="password" id="gate-pwd" class="gate__input" placeholder="Password" autocomplete="off" />
        <button id="gate-btn" class="gate__btn">
          <Icon name="lock_open" />
          Accedi
        </button>
      </div>
      <p id="gate-error" class="gate__error" hidden>Password non corretta</p>
    </div>
  </div>

  <!-- Tool content (nascosto fino ad autenticazione) -->
  <div id="tool" class="lom" style="display:none !important;">
    <div class="lom__header">
      <div class="lom__header-brand">
        <img src="/images/logo-mediocreditofacile.webp" alt="Mediocredito Facile" class="lom__logo" />
        <div class="lom__header-sep"></div>
        <div class="lom__partner-badge">
          <Icon name="person" class="lom__partner-icon" />
          <span class="lom__partner-label">Area Lo Martire</span>
        </div>
      </div>
      <button id="logout-btn" class="lom__logout">
        <Icon name="logout" />
        Esci
      </button>
    </div>

    <div class="lom__hero">
      <div class="lom__hero-content">
        <span class="lom__eyebrow">Strumento dedicato a Lorenzo Lo Martire</span>
        <h1 class="lom__title">Simulatore Leasing Strumentale</h1>
        <p class="lom__sub">
          Tre mandanti (Sella, Alba, Credem), provvigioni al minimo, compenso intermediario dell'1% sull'importo
          aggiunto alle spese istruttoria. Per la promo Alba Easy Lease il compenso sale al 1,20%.
          Il PDF brandizzato MCF mostra al cliente una voce unica "Spese istruttoria" con la somma.
        </p>
      </div>
      <div class="lom__hero-badges">
        <div class="lom__badge">
          <Icon name="trending_down" />
          <span>Provvigioni al minimo</span>
        </div>
        <div class="lom__badge">
          <Icon name="payments" />
          <span>Markup +1% / +1,2%</span>
        </div>
        <div class="lom__badge">
          <Icon name="picture_as_pdf" />
          <span>PDF brandizzato MCF</span>
        </div>
      </div>
    </div>

    <section class="lom__simulator">
      <SimulatoreLeasing client:load varianteLoMartire />
    </section>

    <div class="lom__footer">
      <p>
        Il "Compenso intermediario" mostrato nel breakdown e' il tuo markup, accorpato alle spese istruttoria nel
        PDF cliente. Per assistenza: <a href="tel:+393939957840">+39 393 995 7840</a>.
      </p>
    </div>
  </div>
</ToolLayout>

<script>
  const PASSWORD = 'lorenzo';
  const KEY = 'mcf_lomartire_auth';

  const gate = document.getElementById('gate')!;
  const tool = document.getElementById('tool')!;
  const gatePwd = document.getElementById('gate-pwd') as HTMLInputElement;
  const gateBtn = document.getElementById('gate-btn')!;
  const gateError = document.getElementById('gate-error')!;
  const logoutBtn = document.getElementById('logout-btn')!;

  function showTool() { gate.style.display = 'none'; tool.style.cssText = ''; }
  function showGate() { gate.style.display = ''; tool.style.cssText = 'display:none !important;'; }

  if (localStorage.getItem(KEY) === 'ok') showTool();

  gateBtn.addEventListener('click', () => {
    if (gatePwd.value.trim().toLowerCase() === PASSWORD) {
      localStorage.setItem(KEY, 'ok');
      showTool();
      gateError.hidden = true;
      gatePwd.classList.remove('gate__input--error');
    } else {
      gateError.hidden = false;
      gatePwd.classList.add('gate__input--error');
    }
  });
  gatePwd.addEventListener('keydown', (e) => { if (e.key === 'Enter') gateBtn.click(); });
  logoutBtn.addEventListener('click', () => {
    localStorage.removeItem(KEY); showGate(); gatePwd.value = ''; gateError.hidden = true;
  });
</script>

<style>
  /* === Gate password === */
  .gate {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
    padding: 2rem 1.5rem;
    background: linear-gradient(160deg, #f5f3ff 0%, #ede9fe 50%, #f0fdfa 100%);
  }
  .gate__card {
    text-align: center;
    background: #ffffff;
    border: 1px solid #ddd6fe;
    border-radius: 16px;
    padding: 2.5rem 2.5rem 2rem;
    max-width: 460px;
    width: 100%;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06), 0 1px 4px rgba(102, 76, 205, 0.08);
  }
  .gate__logos { display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; }
  .gate__logo { height: 40px; display: block; }
  .gate__divider { height: 1px; background: linear-gradient(90deg, transparent, #ddd6fe, transparent); margin-bottom: 1.25rem; }
  .gate__label { font-size: 0.82rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; }
  .gate__title { font-size: 1.3rem; font-weight: 800; color: #0F1020; margin: 0 0 0.6rem; letter-spacing: -0.01em; }
  .gate__desc { font-size: 0.85rem; color: #64748b; line-height: 1.5; margin-bottom: 1.5rem; max-width: 380px; margin-left: auto; margin-right: auto; }
  .gate__form { display: flex; gap: 0.6rem; }
  .gate__input {
    flex: 1; padding: 0.8rem 1rem; border: 1.5px solid #e2e8f0; border-radius: 10px;
    font-family: var(--font-family); font-size: 1rem; color: var(--color-text); background: #f8fafc;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .gate__input:focus { outline: none; border-color: #664CCD; box-shadow: 0 0 0 3px rgba(102, 76, 205, 0.15); background: #fff; }
  .gate__input--error { border-color: #ef4444; }
  .gate__btn {
    padding: 0.8rem 1.5rem;
    background: linear-gradient(135deg, #664CCD, #14b8a6);
    color: #ffffff; font-family: var(--font-family); font-weight: 700; font-size: 0.92rem;
    border: none; border-radius: 10px; cursor: pointer;
    transition: transform 0.15s, box-shadow 0.2s; white-space: nowrap;
  }
  .gate__btn:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(102, 76, 205, 0.28); }
  .gate__error { color: #ef4444; font-size: 0.82rem; margin-top: 0.75rem; }

  /* === Tool layout === */
  .lom { max-width: var(--max-width); margin: 0 auto; padding: 0 1.5rem 4rem; }
  .lom__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.25rem 0; border-bottom: 1px solid #e2e8f0;
  }
  .lom__header-brand { display: flex; align-items: center; gap: 1rem; }
  .lom__logo { height: 36px; flex-shrink: 0; }
  .lom__header-sep { width: 1px; height: 28px; background: #e2e8f0; }
  .lom__partner-badge {
    display: flex; align-items: center; gap: 0.4rem;
    background: linear-gradient(135deg, #f5f3ff, #ede9fe);
    border: 1px solid #ddd6fe; border-radius: 8px; padding: 0.35rem 0.75rem;
  }
  .lom__partner-icon { font-size: 1.1rem; color: #664CCD; }
  .lom__partner-label { font-size: 0.85rem; font-weight: 700; color: #5b21b6; }
  .lom__logout {
    background: none; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.4rem 0.85rem;
    font-family: var(--font-family); font-size: 0.82rem; font-weight: 600; color: #64748b;
    cursor: pointer; transition: border-color 0.2s, color 0.2s;
    display: flex; align-items: center; gap: 0.3rem;
  }
  .lom__logout:hover { border-color: #664CCD; color: #664CCD; }

  /* Hero */
  .lom__hero {
    background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 50%, #ecfdf5 100%);
    border: 1px solid #ddd6fe; border-radius: 16px;
    padding: 2rem 2.5rem; margin: 1.5rem 0 2rem;
    display: flex; align-items: flex-start; gap: 2rem;
  }
  .lom__hero-content { flex: 1; }
  .lom__eyebrow {
    display: inline-block; font-size: 0.75rem; font-weight: 800; color: #664CCD;
    text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.6rem;
  }
  .lom__title { font-size: 1.7rem; font-weight: 800; color: #0F1020; line-height: 1.2; margin-bottom: 0.6rem; }
  .lom__sub { font-size: 0.95rem; color: #444451; line-height: 1.65; max-width: 640px; }
  .lom__hero-badges { display: flex; flex-direction: column; gap: 0.5rem; flex-shrink: 0; }
  .lom__badge {
    display: flex; align-items: center; gap: 0.5rem;
    background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;
    padding: 0.5rem 0.85rem; font-size: 0.8rem; font-weight: 600; color: #334155; white-space: nowrap;
  }
  .lom__badge .mcf-icon { font-size: 1rem; color: #664CCD; }

  .lom__simulator { margin-top: 0; }

  .lom__footer {
    border-top: 1px solid #E1DEE3; padding-top: 1.5rem; margin-top: 2rem;
    font-size: 0.85rem; color: #787782; line-height: 1.6; text-align: center;
  }
  .lom__footer a { color: #664CCD; text-decoration: none; font-weight: 600; }
  .lom__footer a:hover { text-decoration: underline; }

  @media print {
    .gate, .lom__header, .lom__hero, .lom__footer { display: none !important; }
    .lom { padding: 0; }
    .lom__simulator { margin: 0; }
  }

  @media (max-width: 768px) {
    .gate__card { padding: 2rem 1.5rem 1.5rem; }
    .gate__form { flex-direction: column; }
    .gate__logo { height: 32px; }
    .gate__title { font-size: 1.2rem; }
    .lom__header-brand { gap: 0.65rem; }
    .lom__logo { height: 28px; }
    .lom__hero { flex-direction: column; padding: 1.5rem; gap: 1.25rem; }
    .lom__title { font-size: 1.3rem; }
    .lom__hero-badges { flex-direction: row; flex-wrap: wrap; }
    .lom__badge { font-size: 0.75rem; padding: 0.4rem 0.65rem; }
  }
</style>
